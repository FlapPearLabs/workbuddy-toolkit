<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.workbuddy.dailycheckin</string>
    <key>ProgramArguments</key>
    <array>
        <!-- 默认指向 ~/.local/bin/wb-checkin，安装脚本会自动替换为当前实际家目录 -->
        <string>{{HOME}}/.local/bin/wb-checkin</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>{{HOME}}/.workbuddy/logs/checkin.log</string>
    <key>StandardErrorPath</key>
    <string>{{HOME}}/.workbuddy/logs/checkin.log</string>
    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
