#!/usr/bin/env python3
# -*- coding: utf-8 -*-
import os
import sys
import json
import time
import shutil
import subprocess
from datetime import datetime

import socket

HOME = os.path.expanduser("~")
LOG_DIR = os.environ.get("WB_LOG_DIR", os.path.join(HOME, ".workbuddy", "logs"))
SANDBOX_DIR = os.path.join(LOG_DIR, "sandbox")
TRACES_DIR = os.environ.get("WB_TRACES_DIR", os.path.join(HOME, ".workbuddy", "traces"))
SESSIONS_DIR = os.environ.get("WB_SESSIONS_DIR", os.path.join(HOME, ".workbuddy", "workspace", "sessions"))
SHELL_SNAPSHOTS_DIR = os.environ.get("WB_SHELL_SNAPSHOTS_DIR", os.path.join(HOME, ".workbuddy", "shell-snapshots"))
CONFIG_FILE = os.environ.get("WB_LOG_GUARD_CONFIG", os.path.join(HOME, ".workbuddy", "log_guard.json"))

def load_config():
    # Defaults
    config = {
        "ttl_minutes": 2160,       # 36 hours
        "max_sandbox_mb": 2048,    # 2GB hard limit
        "target_sandbox_mb": 1536, # 1.5GB target limit when cleaning
        "max_file_mb": 30,         # Single file max 30MB
        "sessions_ttl_hours": 72,   # 3 days
        "max_sessions_keep": 10,    # Max active sessions to retain
        "heal_seatbelt_rules": True, # Auto-inject temp rules into sandbox-center
        "reap_orphaned_daemons": True # Clean up orphaned daemons when GUI is closed
    }
    # Env var overrides
    if "WB_TTL_MINUTES" in os.environ:
        config["ttl_minutes"] = int(os.environ["WB_TTL_MINUTES"])
    if "WB_MAX_SANDBOX_MB" in os.environ:
        config["max_sandbox_mb"] = int(os.environ["WB_MAX_SANDBOX_MB"])
    if "WB_TARGET_SANDBOX_MB" in os.environ:
        config["target_sandbox_mb"] = int(os.environ["WB_TARGET_SANDBOX_MB"])
    if "WB_MAX_FILE_MB" in os.environ:
        config["max_file_mb"] = int(os.environ["WB_MAX_FILE_MB"])
    if "WB_SESSIONS_TTL_HOURS" in os.environ:
        config["sessions_ttl_hours"] = int(os.environ["WB_SESSIONS_TTL_HOURS"])
    if "WB_MAX_SESSIONS_KEEP" in os.environ:
        config["max_sessions_keep"] = int(os.environ["WB_MAX_SESSIONS_KEEP"])
    if "WB_HEAL_SEATBELT_RULES" in os.environ:
        config["heal_seatbelt_rules"] = os.environ["WB_HEAL_SEATBELT_RULES"].lower() in ("1", "true", "yes")
    if "WB_REAP_ORPHANED_DAEMONS" in os.environ:
        config["reap_orphaned_daemons"] = os.environ["WB_REAP_ORPHANED_DAEMONS"].lower() in ("1", "true", "yes")

    if os.path.exists(CONFIG_FILE):
        try:
            with open(CONFIG_FILE, "r", encoding="utf-8") as f:
                file_cfg = json.load(f)
                for k in config.keys():
                    if k in file_cfg:
                        config[k] = file_cfg[k]
        except Exception as e:
            print(f"Failed to read {CONFIG_FILE}: {e}", file=sys.stderr)
            
    return config

def get_open_files(directory):
    open_files = set()
    if not os.path.exists(directory) or os.name == 'nt':
        return open_files
    try:
        # lsof +D <dir> is recursive, -F n outputs file paths
        result = subprocess.run(["lsof", "-F", "n", "+D", os.path.realpath(directory)], 
                                stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, timeout=15, close_fds=True)
        for line in result.stdout.splitlines():
            if line.startswith('n/'):
                open_files.add(os.path.realpath(line[1:]))
    except Exception:
        pass
    return open_files

def truncate_file(filepath):
    try:
        with open(filepath, 'w') as f:
            pass # Truncate to 0
        return True
    except Exception:
        return False

def remove_file(filepath):
    try:
        os.remove(filepath)
        return True
    except Exception:
        return False

def is_file_open(filepath, open_files_set):
    real_fp = os.path.realpath(filepath)
    if real_fp in open_files_set:
        return True
    
    if os.name == 'nt':
        try:
            # On Windows, try to rename it. If it's opened by another process, it will raise PermissionError or Sharing Violation.
            tmp = filepath + ".wblck"
            os.rename(filepath, tmp)
            os.rename(tmp, filepath)
            return False
        except OSError as e:
            if getattr(e, 'winerror', None) == 32 or getattr(e, 'winerror', None) == 33 or e.errno == 13:
                return True
            return False
    return False

def get_dir_size(directory):
    total = 0
    for dirpath, _, filenames in os.walk(directory):
        for f in filenames:
            fp = os.path.join(dirpath, f)
            if not os.path.islink(fp) and os.path.isfile(fp):
                total += os.path.getsize(fp)
    return total

def clean_session_snapshots(sessions_dir, open_files_set=None, ttl_hours=72, max_keep=10):
    """
    Surgically cleans up old WorkBuddy session snapshots and modify backups.
    Protects active sessions, open files, and recent sessions (< ttl_hours).
    """
    if not os.path.exists(sessions_dir):
        return 0, 0
    now = time.time()
    ttl_seconds = ttl_hours * 3600
    cleaned_sessions = 0
    freed_bytes = 0

    if open_files_set is None:
        open_files = get_open_files(sessions_dir)
    else:
        open_files = set(open_files_set)
        if os.path.exists(sessions_dir):
            open_files.update(get_open_files(sessions_dir))

    sessions = []
    try:
        entries = os.listdir(sessions_dir)
    except Exception:
        return 0, 0

    for item in entries:
        sp = os.path.join(sessions_dir, item)
        if os.path.isdir(sp):
            try:
                st = os.stat(sp)
                sessions.append((st.st_mtime, sp, item))
            except Exception:
                pass

    # Sort descending: newest sessions first
    sessions.sort(key=lambda x: x[0], reverse=True)

    for idx, (mtime, sp, item) in enumerate(sessions):
        # Keep the most recent active sessions unless older than TTL
        is_older_than_ttl = (now - mtime) > ttl_seconds
        exceeds_keep = (idx >= max_keep)

        if not (is_older_than_ttl or exceeds_keep):
            continue

        # Check if session lockfile or any files inside session are open
        real_sp = os.path.realpath(sp)
        lock_file = os.path.join(sp, "center.backup.lock")
        is_locked = (os.path.exists(lock_file) and is_file_open(lock_file, open_files))
        has_open_files = any(f.startswith(real_sp + os.sep) for f in open_files)
        if is_locked or has_open_files:
            continue

        # Targeted surgical deletion of snapshot artifacts only
        for target_subdir in ["modify_backup", ".modify_backup_meta", "snapfile"]:
            target_path = os.path.join(sp, target_subdir)
            if os.path.exists(target_path):
                try:
                    freed_bytes += get_dir_size(target_path)
                    shutil.rmtree(target_path, ignore_errors=True)
                except Exception:
                    pass

        # If session is old (> ttl) and essentially empty, clean up directory
        if is_older_than_ttl:
            try:
                remaining = [f for f in os.listdir(sp) if f != "center.backup.lock"]
                if not remaining:
                    shutil.rmtree(sp, ignore_errors=True)
                    cleaned_sessions += 1
            except Exception:
                pass

    return cleaned_sessions, freed_bytes

def clean_shell_snapshots(snapshots_dir, ttl_hours=72):
    """
    Cleans up stale shell snapshot bundles.
    """
    if not os.path.exists(snapshots_dir):
        return 0
    now = time.time()
    ttl_seconds = ttl_hours * 3600
    cleaned = 0
    for root, _, filenames in os.walk(snapshots_dir):
        for f in filenames:
            fp = os.path.join(root, f)
            try:
                if now - os.path.getmtime(fp) > ttl_seconds:
                    if remove_file(fp):
                        cleaned += 1
            except Exception:
                pass
    return cleaned

def find_sandbox_center_socket(socket_dir=None):
    """
    Locates active sandbox-center Unix domain socket.
    """
    if os.name == 'nt':
        return None
    search_dir = socket_dir or "/tmp"
    if not os.path.exists(search_dir):
        return None
    candidates = []
    try:
        for f in os.listdir(search_dir):
            if f.startswith("workbuddy-sandbox-center-") and f.endswith(".sock"):
                fp = os.path.join(search_dir, f)
                try:
                    st = os.stat(fp)
                    candidates.append((st.st_mtime, fp))
                except Exception:
                    pass
    except Exception:
        pass
    if not candidates:
        return None
    candidates.sort(key=lambda x: x[0], reverse=True)
    return candidates[0][1]

MAX_IPC_PAYLOAD = 4 * 1024 * 1024  # 4MB 硬上限，超限熔断

def send_sandbox_ipc(socket_path, command, data, uid="default", timeout=2.0):
    """
    Sends a structured IPC request to sandbox-center and returns parsed JSON.
    Protected with overall monotonic deadline and 4MB max payload limits (Fail-Open).
    """
    if not socket_path or not os.path.exists(socket_path) or os.name == 'nt':
        return None

    req = {
        "messageId": f"wb-guard:{int(time.time()*1000)}",
        "command": command,
        "uid": uid,
        "data": {
            **data,
            "_client": {"role": "agent-cli", "pid": os.getpid()}
        }
    }
    try:
        payload = json.dumps(req).encode("utf-8") + b"\n"
    except Exception:
        return None

    if len(payload) > MAX_IPC_PAYLOAD:
        return None

    end_time = time.monotonic() + timeout
    s = None
    try:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.settimeout(timeout)
        s.connect(socket_path)
        s.sendall(payload)

        res = b""
        while True:
            remain = end_time - time.monotonic()
            if remain <= 0:
                return None
            s.settimeout(min(remain, 0.5))
            try:
                chunk = s.recv(65536)
            except (socket.timeout, BlockingIOError):
                continue
            if not chunk:
                break
            res += chunk
            if len(res) > MAX_IPC_PAYLOAD:
                return None
            stripped = res.strip()
            if stripped.startswith(b"{") and stripped.endswith(b"}"):
                try:
                    return json.loads(stripped.decode("utf-8"))
                except Exception:
                    pass
        if res.strip():
            try:
                return json.loads(res.decode("utf-8"))
            except Exception:
                return None
        return None
    except Exception:
        return None
    finally:
        if s is not None:
            try:
                s.close()
            except Exception:
                pass

def find_active_uid():
    """Locates active WorkBuddy user UID from desktop auth info or profiles."""
    if sys.platform == "darwin":
        candidates = [
            os.path.expanduser("~/Library/Application Support/CodeBuddyExtension/Data/Public/auth/workbuddy-desktop.info"),
            os.path.expanduser("~/.workbuddy/auth/workbuddy-desktop.info"),
        ]
    elif sys.platform == "win32":
        appdata = os.environ.get("APPDATA", os.path.expanduser("~\\AppData\\Roaming"))
        localappdata = os.environ.get("LOCALAPPDATA", os.path.expanduser("~\\AppData\\Local"))
        userprofile = os.environ.get("USERPROFILE", os.path.expanduser("~"))
        candidates = [
            os.path.join(appdata, "CodeBuddyExtension", "Data", "Public", "auth", "workbuddy-desktop.info"),
            os.path.join(localappdata, "CodeBuddyExtension", "Data", "Public", "auth", "workbuddy-desktop.info"),
            os.path.join(userprofile, ".workbuddy", "auth", "workbuddy-desktop.info"),
        ]
    else:  # Linux & others
        config_home = os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config"))
        data_home = os.environ.get("XDG_DATA_HOME", os.path.expanduser("~/.local/share"))
        candidates = [
            os.path.join(config_home, "CodeBuddyExtension", "Data", "Public", "auth", "workbuddy-desktop.info"),
            os.path.join(data_home, "CodeBuddyExtension", "Data", "Public", "auth", "workbuddy-desktop.info"),
            os.path.expanduser("~/.workbuddy/auth/workbuddy-desktop.info"),
        ]
    for af in candidates:
        if os.path.exists(af):
            try:
                with open(af, "r", encoding="utf-8") as f:
                    data = json.load(f)
                    uid = data.get("account", {}).get("uid") or data.get("uid")
                    if uid:
                        return uid
            except Exception:
                pass
    profiles_dir = os.path.expanduser("~/.workbuddy/auth_profiles")
    if os.path.exists(profiles_dir):
        for f in os.listdir(profiles_dir):
            if f.endswith(".info"):
                try:
                    with open(os.path.join(profiles_dir, f), "r", encoding="utf-8") as pf:
                        data = json.load(pf)
                        uid = data.get("account", {}).get("uid") or data.get("uid")
                        if uid:
                            return uid
                except Exception:
                    pass
    return "default"

def _acquire_file_lock(lock_path, timeout=5.0):
    """跨平台轻量文件锁，确保多 Agent 并发时不发生 heal 竞态与规则撕裂。"""
    try:
        os.makedirs(os.path.dirname(os.path.abspath(lock_path)), exist_ok=True)
        fd = os.open(lock_path, os.O_CREAT | os.O_RDWR, 0o600)
    except OSError:
        return None
    end = time.monotonic() + timeout
    if sys.platform == "win32":
        import msvcrt
        while True:
            try:
                msvcrt.locking(fd, msvcrt.LK_NBLCK, 1)
                return fd
            except OSError:
                if time.monotonic() >= end:
                    try:
                        os.close(fd)
                    except Exception:
                        pass
                    return None
                time.sleep(0.05)
    else:
        import fcntl
        while True:
            try:
                fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                return fd
            except OSError:
                if time.monotonic() >= end:
                    try:
                        os.close(fd)
                    except Exception:
                        pass
                    return None
                time.sleep(0.05)

def _release_file_lock(fd):
    """安全释放跨平台文件锁并关闭句柄。"""
    if fd is None:
        return
    try:
        if sys.platform == "win32":
            import msvcrt
            try:
                os.lseek(fd, 0, os.SEEK_SET)
                msvcrt.locking(fd, msvcrt.LK_UNLCK, 1)
            except OSError:
                pass
        else:
            import fcntl
            try:
                fcntl.flock(fd, fcntl.LOCK_UN)
            except OSError:
                pass
    finally:
        try:
            os.close(fd)
        except Exception:
            pass

def heal_sandbox_center_rules(socket_path=None, uid=None):
    """
    Ensures macOS/Linux temp wildcard rules are active in sandbox-center
    and prunes bloated auto_grant rules to prevent SBPL compilation lockup.
    Guarded by cross-process single-flight lock and post-injection readback verification.
    """
    target_uid = uid or find_active_uid()
    sock = socket_path or find_sandbox_center_socket()
    if not sock:
        return {"status": "no_socket"}

    lock_path = os.environ.get("WORKBUDDY_HEAL_LOCK") or os.path.expanduser("~/.workbuddy/cache/heal.lock")
    lock_fd = _acquire_file_lock(lock_path, timeout=5.0)
    if lock_fd is None:
        return {"status": "locked_skip"}

    try:
        # 1. Probe current rules
        rules_resp = send_sandbox_ipc(sock, "sandbox.rules.get_rules", {}, uid=target_uid)
        if not rules_resp or not rules_resp.get("success"):
            return {"status": "unresponsive"}

        existing_rules = rules_resp.get("data", {}).get("fileRules", [])
        existing_paths = {r.get("path") for r in existing_rules if isinstance(r, dict)}

        temp_paths = [
            "/var/folders/**",
            "/private/var/folders/**",
            "/tmp/**",
            "/private/tmp/**",
            "/var/tmp/**",
            "/private/var/tmp/**"
        ]
        missing = [p for p in temp_paths if p not in existing_paths]

        added_count = 0
        if missing:
            to_add = [{"path": p, "action": "read=allow|write=allow|delete=allow", "isDirectory": True} for p in missing]
            add_resp = send_sandbox_ipc(sock, "sandbox.rules.add_file_rule", {"category": "global", "rules": to_add}, uid=target_uid)
            if add_resp and add_resp.get("success"):
                added_count = len(missing)

        # 2. Prune auto_grant rules if bloated (> 500 rules)
        cleared_auto_grant = False
        if len(existing_rules) > 500:
            send_sandbox_ipc(sock, "sandbox.rules.set_file_rules", {"category": "auto_grant", "rules": []}, uid=target_uid)
            send_sandbox_ipc(sock, "sandbox.rules.set_file_rules", {"category": "temp", "rules": []}, uid=target_uid)
            cleared_auto_grant = True

        # 3. Readback verification (锁内回读校验与断言)
        verified = True
        total_rules = len(existing_rules) + added_count
        verify_resp = send_sandbox_ipc(sock, "sandbox.rules.get_rules", {}, uid=target_uid)
        if verify_resp and verify_resp.get("success"):
            v_rules = verify_resp.get("data", {}).get("fileRules", [])
            if v_rules:
                v_paths = {r.get("path") for r in v_rules if isinstance(r, dict)}
                verified = any(p in v_paths for p in temp_paths) or (len(v_rules) >= len(existing_rules))
                total_rules = max(total_rules, len(v_rules))

        return {
            "status": "ok",
            "total_rules": total_rules,
            "added_temp_rules": added_count,
            "cleared_auto_grant": cleared_auto_grant,
            "verified": verified
        }
    finally:
        _release_file_lock(lock_fd)

def is_workbuddy_gui_running():
    """
    Checks if WorkBuddy desktop GUI application is actively running across platforms.
    Prioritizes zero-fork macOS libproc FFI, /proc filesystem read on Linux, and tasklist on Windows.
    """
    if sys.platform == "darwin":
        try:
            import ctypes
            libproc = ctypes.CDLL("libproc.dylib")
            needed = libproc.proc_listpids(1, 0, None, 0)
            num_slots = max(2048, (needed // ctypes.sizeof(ctypes.c_int)) + 128) if needed > 0 else 2048
            pids = (ctypes.c_int * num_slots)()
            bytes_ret = libproc.proc_listpids(1, 0, pids, ctypes.sizeof(pids))
            num_pids = bytes_ret // ctypes.sizeof(ctypes.c_int)
            buf = ctypes.create_string_buffer(1024)
            for i in range(num_pids):
                pid = pids[i]
                if pid <= 0:
                    continue
                if libproc.proc_pidpath(pid, buf, 1024) > 0:
                    p = buf.value.decode("utf-8", errors="ignore")
                    if "WorkBuddy.app/Contents/MacOS" in p and "Helper" not in p and "crashpad" not in p:
                        return True
            return False
        except Exception:
            pass
        # Fallback for Darwin if libproc fails
        try:
            res = subprocess.run(["pgrep", "-f", r"WorkBuddy\.app/Contents/MacOS/(Electron|WorkBuddy)"],
                                 stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, timeout=5, close_fds=True)
            if res.stdout.strip():
                return True
            res2 = subprocess.run(["pgrep", "-f", "WorkBuddy.app/Contents/MacOS"],
                                  stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, timeout=5, close_fds=True)
            return bool(res2.stdout.strip())
        except Exception:
            return False
    elif sys.platform == "win32":
        try:
            res = subprocess.run(["tasklist", "/fi", "IMAGENAME eq WorkBuddy.exe"],
                                 stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, timeout=5, close_fds=True)
            return "WorkBuddy.exe" in (res.stdout or "")
        except Exception:
            return False
    else:  # Linux: read /proc directly without fork
        try:
            for entry in os.listdir("/proc"):
                if entry.isdigit():
                    cmdline_p = os.path.join("/proc", entry, "cmdline")
                    if os.path.exists(cmdline_p):
                        with open(cmdline_p, "rb") as f:
                            content = f.read().replace(b"\x00", b" ").decode("utf-8", errors="ignore").lower()
                            if "workbuddy" in content and "workbuddy-log-guard" not in content and "python" not in content:
                                return True
            return False
        except Exception:
            pass
        try:
            res = subprocess.run(["pgrep", "-f", "-i", "workbuddy"],
                                 stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, timeout=5, close_fds=True)
            return bool(res.stdout.strip())
        except Exception:
            return False

def reap_orphaned_daemons(protected_keywords=None):
    """
    Reaps orphaned sandbox-center, sandbox-cli-gc, and codebuddy daemons
    ONLY IF WorkBuddy GUI is closed AND no protected user workloads or active sandbox sessions are running.
    """
    if protected_keywords is None:
        protected_keywords = ["zhihu", "zhihugrabber", "cargo", "rustc", "gcc", "clang", "ninja", "make", "python", "node", "npm", "vite", "webpack", "go", "pytest"]

    if is_workbuddy_gui_running():
        return {"reaped": False, "reason": "gui_running"}

    # Inspect running processes for protected workloads and daemons
    proc_list = []
    # Try zero-fork on Darwin via sysctl KERN_PROCARGS2 + libproc
    if sys.platform == "darwin":
        try:
            import ctypes
            libc = ctypes.CDLL(None)
            libproc = ctypes.CDLL("libproc.dylib")
            CTL_KERN = 1
            KERN_PROCARGS2 = 49
            needed = libproc.proc_listpids(1, 0, None, 0)
            num_slots = max(2048, (needed // ctypes.sizeof(ctypes.c_int)) + 128) if needed > 0 else 2048
            pids = (ctypes.c_int * num_slots)()
            bytes_ret = libproc.proc_listpids(1, 0, pids, ctypes.sizeof(pids))
            num_pids = bytes_ret // ctypes.sizeof(ctypes.c_int)
            size = ctypes.c_size_t(0)
            for i in range(num_pids):
                pid = pids[i]
                if pid <= 0:
                    continue
                mib = (ctypes.c_int * 3)(CTL_KERN, KERN_PROCARGS2, pid)
                size.value = 0
                ret = libc.sysctl(mib, 3, None, ctypes.byref(size), None, 0)
                if ret != 0 or size.value == 0:
                    continue
                buf = ctypes.create_string_buffer(size.value)
                ret = libc.sysctl(mib, 3, buf, ctypes.byref(size), None, 0)
                if ret != 0:
                    continue
                raw = buf.raw
                if len(raw) < 4:
                    continue
                argc = int.from_bytes(raw[:4], byteorder="little")
                pos = 4
                null_pos = raw.find(b"\x00", pos)
                if null_pos == -1:
                    continue
                pos = null_pos
                while pos < len(raw) and raw[pos] == 0:
                    pos += 1
                args = []
                for _ in range(min(argc, 64)):
                    next_null = raw.find(b"\x00", pos)
                    if next_null == -1:
                        break
                    args.append(raw[pos:next_null].decode("utf-8", errors="ignore"))
                    pos = next_null + 1
                proc_list.append((pid, " ".join(args)))
        except Exception:
            proc_list = []

    if not proc_list:
        try:
            ps_out = subprocess.run(["ps", "-A", "-o", "pid,command"],
                                    stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, timeout=5, close_fds=True).stdout
            for line in ps_out.splitlines()[1:]:
                parts = line.strip().split(None, 1)
                if len(parts) >= 2:
                    try:
                        proc_list.append((int(parts[0]), parts[1]))
                    except ValueError:
                        pass
        except Exception:
            return {"reaped": False, "reason": "ps_failed"}

    daemon_pids = []
    has_protected_task = False
    has_active_sandbox_cli = False

    for pid, cmd in proc_list:
        cmd_lower = cmd.lower()

        # Check for user-protected tasks
        for kw in protected_keywords:
            if kw.lower() in cmd_lower and "sandbox" not in cmd_lower and "workbuddy-log-guard" not in cmd_lower:
                has_protected_task = True
                break

        if "sandbox-cli " in cmd or cmd.endswith("sandbox-cli"):
            has_active_sandbox_cli = True

        if "sandbox-center" in cmd or "sandbox-cli-gc" in cmd or ("codebuddy" in cmd and "--prewarm" in cmd):
            daemon_pids.append(pid)

    if has_protected_task:
        return {"reaped": False, "reason": "user_workload_active"}
    if has_active_sandbox_cli:
        return {"reaped": False, "reason": "sandbox_cli_active"}

    reaped_pids = []
    for pid in daemon_pids:
        try:
            os.kill(pid, 15)  # SIGTERM
            reaped_pids.append(pid)
        except OSError:
            pass

    # Clean up lockfiles if all daemons stopped
    if reaped_pids:
        time.sleep(0.5)
        for lock_name in ["workbuddy-sandbox-center", "workbuddy-sandbox-cli-gc"]:
            for f in os.listdir("/tmp"):
                if f.startswith(lock_name) and f.endswith(".lock"):
                    try:
                        os.remove(os.path.join("/tmp", f))
                    except Exception:
                        pass

    return {"reaped": len(reaped_pids) > 0, "pids": reaped_pids}

def main():
    config = load_config()
    ttl_seconds = config["ttl_minutes"] * 60
    max_file_bytes = config["max_file_mb"] * 1024 * 1024
    max_sandbox_bytes = config["max_sandbox_mb"] * 1024 * 1024
    target_sandbox_bytes = config["target_sandbox_mb"] * 1024 * 1024
    now = time.time()
    today_str = datetime.now().strftime("%Y%m%d")

    open_files = get_open_files(LOG_DIR)
    if os.path.exists(SESSIONS_DIR):
        open_files.update(get_open_files(SESSIONS_DIR))

    # 1. Truncate over-sized files (even if not open)
    if os.path.exists(LOG_DIR):
        for dirpath, _, filenames in os.walk(LOG_DIR):
            for f in filenames:
                fp = os.path.join(dirpath, f)
                try:
                    if os.path.getsize(fp) > max_file_bytes:
                        truncate_file(fp)
                except Exception:
                    pass

    # 2. TTL Cleanup for sandbox
    if os.path.exists(SANDBOX_DIR):
        for dirpath, dirnames, filenames in os.walk(SANDBOX_DIR):
            dir_basename = os.path.basename(dirpath)
            for f in filenames:
                fp = os.path.join(dirpath, f)
                real_fp = os.path.realpath(fp)
                try:
                    mtime = os.path.getmtime(fp)
                    if now - mtime > ttl_seconds:
                        if is_file_open(fp, open_files):
                            if os.name != 'nt':
                                truncate_file(fp)
                        elif dir_basename != today_str and dir_basename != "sandbox":
                            remove_file(fp)
                except Exception:
                    pass
        
        # 3. Directory capacity hard limit
        current_size = get_dir_size(SANDBOX_DIR)
        if current_size > max_sandbox_bytes:
            # Collect files, sort by mtime
            all_files = []
            for dirpath, _, filenames in os.walk(SANDBOX_DIR):
                dir_basename = os.path.basename(dirpath)
                for f in filenames:
                    fp = os.path.join(dirpath, f)
                    try:
                        all_files.append((os.path.getmtime(fp), fp, dir_basename))
                    except Exception:
                        pass
            all_files.sort(key=lambda x: x[0])
            
            for mtime, fp, dir_basename in all_files:
                if current_size <= target_sandbox_bytes:
                    break
                try:
                    size = os.path.getsize(fp)
                    real_fp = os.path.realpath(fp)
                    if is_file_open(fp, open_files):
                        if os.name != 'nt':
                            if truncate_file(fp):
                                current_size -= size
                    elif dir_basename != today_str and dir_basename != "sandbox":
                        if remove_file(fp):
                            current_size -= size
                except Exception:
                    pass

    # 4. Other log dir cleanup
    if os.path.exists(LOG_DIR):
        for dirpath, dirnames, filenames in os.walk(LOG_DIR, topdown=False):
            # Skip root log dir and sandbox dir correctly
            if dirpath == LOG_DIR or dirpath.startswith(os.path.join(SANDBOX_DIR, "")) or dirpath == SANDBOX_DIR:
                continue
            for f in filenames:
                fp = os.path.join(dirpath, f)
                real_fp = os.path.realpath(fp)
                try:
                    if now - os.path.getmtime(fp) > ttl_seconds:
                        if is_file_open(fp, open_files):
                            if os.name != 'nt':
                                truncate_file(fp)
                        else:
                            remove_file(fp)
                except Exception:
                    pass
            # Clean empty directories (bottom-up traversal makes this work properly)
            if not os.listdir(dirpath):
                try:
                    os.rmdir(dirpath)
                except Exception:
                    pass

    # 5. Clean traces directory (24 hours TTL)
    traces_ttl = 24 * 3600
    if os.path.exists(TRACES_DIR):
        for dirpath, dirnames, filenames in os.walk(TRACES_DIR, topdown=False):
            for f in filenames:
                fp = os.path.join(dirpath, f)
                try:
                    if now - os.path.getmtime(fp) > traces_ttl:
                        remove_file(fp)
                except Exception:
                    pass
            if dirpath != TRACES_DIR and not os.listdir(dirpath):
                try:
                    os.rmdir(dirpath)
                except Exception:
                    pass

    # 6. Clean WorkBuddy session snapshots and modify backups (default TTL: 72h / 3 days)
    sessions_ttl = config.get("sessions_ttl_hours", 72)
    max_sessions = config.get("max_sessions_keep", 10)
    clean_session_snapshots(SESSIONS_DIR, open_files, ttl_hours=sessions_ttl, max_keep=max_sessions)

    # 7. Clean shell snapshots
    clean_shell_snapshots(SHELL_SNAPSHOTS_DIR, ttl_hours=sessions_ttl)

    # 8. Auto-heal Seatbelt rules in live sandbox-center
    if config.get("heal_seatbelt_rules", True):
        try:
            heal_sandbox_center_rules()
        except Exception:
            pass

    # 9. Reap orphaned sandbox daemons if GUI is closed
    if config.get("reap_orphaned_daemons", True):
        try:
            reap_orphaned_daemons()
        except Exception:
            pass

if __name__ == "__main__":
    main()
