def _parse_audit_cli_args(args_list):
    force = any(a in ("--force", "-f") for a in args_list)
    daemon_mode = False
    interval_hours = 6.0
    i = 0
    while i < len(args_list):
        arg = args_list[i]
        if arg in ("--daemon", "-d"):
            daemon_mode = True
            if i + 1 < len(args_list) and not args_list[i + 1].startswith("-"):
                try:
                    interval_hours = float(args_list[i + 1])
                    i += 1
                except ValueError:
                    pass
        elif arg.startswith("--daemon="):
            daemon_mode = True
            try:
                interval_hours = float(arg.split("=", 1)[1])
            except ValueError:
                pass
        elif arg in ("--interval", "-i"):
            daemon_mode = True
            if i + 1 < len(args_list) and not args_list[i + 1].startswith("-"):
                try:
                    interval_hours = float(args_list[i + 1])
                    i += 1
                except ValueError:
                    pass
        elif arg.startswith("--interval="):
            daemon_mode = True
            try:
                interval_hours = float(arg.split("=", 1)[1])
            except ValueError:
                pass
        i += 1
    return force, daemon_mode, interval_hours

# remove 子命令只认这些开关。`--force` 与 `-y/--yes` **不互为别名**：
# 前者是"放宽保护"，后者是"跳过确认"；混用会让只想跳过确认的人误删活跃账号。
REMOVE_BOOL_FLAGS = {
    "--yes": "yes", "-y": "yes", "--confirm": "yes",
    "--force": "force",
    "--purge": "purge",
    "--purge-memory": "purge_memory",
    "--json": "json", "-j": "json",
    "--list-trash": "list_trash",
}

REMOVE_USAGE = (
    "用法:\n"
    "  workbuddy remove <账号名|昵称|UID> [--yes] [--force] [--purge] [--purge-memory] [--json]\n"
    "  workbuddy remove --list-trash [--json]\n"
    "  workbuddy remove --restore <回收站文件名> [--yes] [--force] [--json]\n"
    "  workbuddy remove --restore-memory <归档目录名> [--json]\n"
    "  workbuddy remove --purge-trash <文件名|归档目录名> [--yes] [--json]"
)

class RemoveArgsError(ValueError):
    """remove 子命令参数非法（未知选项 / 多目标 / 缺值）。"""

def _parse_remove_cli_args(args_list):
    """严格解析 remove 子命令参数，返回 {mode, target, restore, yes, force, purge, json}。

    破坏性命令不做"尽力而为"的解析：
    - 未知选项直接报错，避免 `remove a --dry-run` 把 a 真删掉；
    - 多于一个目标直接报错，避免 `remove a b` 静默只处理 a；
    - `--` 之后一律按位置参数处理，用来支持 `-weird` 这类连字符开头的别名。
    """
    opts = {"yes": False, "force": False, "purge": False, "purge_memory": False,
            "json": False, "list_trash": False}
    restore = None
    restore_memory = None
    purge_trash = None
    positionals = []
    i = 0
    total = len(args_list)
    while i < total:
        arg = str(args_list[i])
        if arg == "--":
            positionals.extend(str(a) for a in args_list[i + 1:])
            break
        if arg == "--restore":
            if i + 1 >= total:
                raise RemoveArgsError("--restore 需要一个回收站文件名")
            restore = str(args_list[i + 1])
            i += 2
            continue
        if arg == "--restore-memory":
            if i + 1 >= total:
                raise RemoveArgsError("--restore-memory 需要一个归档目录名")
            restore_memory = str(args_list[i + 1])
            i += 2
            continue
        if arg == "--purge-trash":
            if i + 1 >= total:
                raise RemoveArgsError("--purge-trash 需要一个回收站文件名/归档目录名")
            purge_trash = str(args_list[i + 1])
            i += 2
            continue
        if arg in REMOVE_BOOL_FLAGS:
            opts[REMOVE_BOOL_FLAGS[arg]] = True
        elif arg.startswith("-") and arg != "-":
            raise RemoveArgsError(f"未知选项: {arg}")
        else:
            positionals.append(arg)
        i += 1

    def _result(mode, target=None, restore_name=None, restore_mem=None, purge_name=None):
        return {"mode": mode, "target": target, "restore": restore_name,
                "restore_memory": restore_mem, "purge_trash": purge_name, **opts}

    if opts["list_trash"]:
        if restore or restore_memory or purge_trash or positionals or opts["purge"] or opts["purge_memory"]:
            raise RemoveArgsError(
                "--list-trash 不能与账号名 / --restore / --restore-memory / "
                "--purge-trash / --purge / --purge-memory 同时使用")
        return _result("list")
    if restore:
        if restore_memory or purge_trash or positionals or opts["purge"] or opts["purge_memory"]:
            raise RemoveArgsError(
                "--restore 不能与账号名 / --restore-memory / --purge-trash / "
                "--purge / --purge-memory 同时使用")
        if "/" in restore or "\\" in restore or restore in (".", ".."):
            raise RemoveArgsError("--restore 只接受回收站里的文件名，不能带路径")
        return _result("restore", restore_name=restore)
    if restore_memory:
        if purge_trash or positionals or opts["purge"] or opts["purge_memory"]:
            raise RemoveArgsError(
                "--restore-memory 不能与账号名 / --purge-trash / --purge / --purge-memory 同时使用")
        if "/" in restore_memory or "\\" in restore_memory or restore_memory in (".", ".."):
            raise RemoveArgsError("--restore-memory 只接受归档目录名，不能带路径")
        return _result("restore_memory", restore_mem=restore_memory)
    if purge_trash:
        if positionals or opts["purge"] or opts["purge_memory"]:
            raise RemoveArgsError(
                "--purge-trash 不能与账号名 / --purge / --purge-memory 同时使用")
        if "/" in purge_trash or "\\" in purge_trash or purge_trash in (".", ".."):
            raise RemoveArgsError("--purge-trash 只接受回收站里的文件名/归档名，不能带路径")
        return _result("purge_trash", purge_name=purge_trash)
    if not positionals:
        raise RemoveArgsError("缺少要删除的账号名")
    if len(positionals) > 1:
        raise RemoveArgsError("一次只能处理一个账号，收到 {} 个: {}".format(
            len(positionals), ", ".join(positionals)))
    return _result("remove", target=positionals[0])

def run_remove_cmd(args_list):
    """`workbuddy remove` 子命令入口。退出码: 0 成功，1 未执行，2 参数错误。"""
    if any(a in ("-h", "--help") for a in args_list):
        print(REMOVE_USAGE)
        print("  -y, --yes        跳过交互确认（非交互式环境必须显式指定）")
        print("  --force          放宽保护：删当前活跃账号 / 身份未知的损坏凭证 / 覆盖恢复目标 / 同 UID 共享记忆")
        print("  --purge          直接永久删除凭证，不保留回收站副本")
        print("  --purge-memory   同时清理该账号的人格/记忆（user-<uid>-*/、memory/<uid>_memory.md）")
        print("  --list-trash     列出回收站里的凭证备份与记忆归档")
        print("  --restore <文件>  把指定凭证备份还原为账号配置（配对记忆一起还原）")
        print("  --restore-memory <名称>  单独还原一个记忆归档（凭证已删/改名时用）")
        print("  --purge-trash <名称>     清除单条回收站残留（0 字节占位/损坏备份）")
        print("  --json           以 JSON 输出，便于脚本消费")
        print("  --               之后的内容按位置参数处理（用于 - 开头的别名）")
        return 0
    try:
        opts = _parse_remove_cli_args(args_list)
    except RemoveArgsError as e:
        print(f"{COLOR_RED}参数错误: {e}{COLOR_RESET}")
        print(REMOVE_USAGE)
        return 2

    if opts["mode"] == "list":
        return list_trash_cmd(as_json=opts["json"])
    if opts["mode"] == "restore_memory":
        return restore_memory_cmd(opts["restore_memory"], as_json=opts["json"])
    if opts["mode"] == "purge_trash":
        res = purge_trash_cmd(opts["purge_trash"], yes=opts["yes"], as_json=opts["json"])
        return 0 if res.get("ok") else 1
    if opts["mode"] == "restore":
        res = restore_from_trash(opts["restore"], yes=opts["yes"],
                                 force=opts["force"], as_json=opts["json"])
        return 0 if res.get("ok") else 1
    res = remove_profile(opts["target"], yes=opts["yes"], force=opts["force"],
                         purge=opts["purge"], purge_memory=opts["purge_memory"],
                         as_json=opts["json"])
    return 0 if res.get("ok") else 1

def run_interactive_tool_cmd(args=None):
    """启动图形化交互控制中心 (wb-tool / workbuddy tool)"""
    sidecar_dir = find_sidecar_dir()
    if sidecar_dir not in sys.path:
        sys.path.insert(0, sidecar_dir)
    import interactive_tool
    ctx = {
        "version": VERSION,
        "auth_file": AUTH_FILE,
        "profiles_dir": PROFILES_DIR,
        "db_file": DB_FILE,
        "get_active_account": get_active_account,
        "get_profiles": get_profiles,
        "switch_to_profile": switch_to_profile,
        "run_login": run_login,
        "remove_profile": remove_profile,
        "run_audit": run_audit,
        "run_checkin": run_checkin,
        "run_models_cmd": run_models_cmd,
        "run_usage_cmd": run_usage_cmd,
        "run_sandbox_cmd": run_sandbox_cmd,
        "restart_workbuddy": restart_workbuddy,
        "show_status": show_status,
        "check_profile_health": check_profile_health,
        "get_display_nickname": get_display_nickname,
        "notify_desktop": notify_desktop,
    }
    code = interactive_tool.run_interactive_tool(ctx, args=args)
    sys.exit(code)

def print_help():
    print(f"""
{COLOR_BOLD}WorkBuddy CLI (v{VERSION}){COLOR_RESET}

用法:
  workbuddy <命令> [选项]
  或使用快捷别名 (如 wb-login, wb-switch)

常用命令:
  workbuddy tool                  启动图形化交互控制中心 (别名: wb-tool, workbuddy-tool)
  workbuddy help                  查看本帮助信息 (别名: wb-help, workbuddy-help)
  workbuddy login [别名] [--force] 独立免登扫码录入 (别名: wb-login)
  workbuddy switch [账号名]        免重新扫码切换账号 (别名: wb-switch)
  workbuddy remove <账号名> [--yes] 删除本地账号凭证 (别名: wb-remove)
  workbuddy list / status [--json] 查看账号列表与凭证状态 (别名: wb-list, wb-status)
  workbuddy audit [--daemon]      凭据健康审计与常驻巡检 (别名: wb-audit)
  workbuddy usage [选项]           积分消耗与流速统计 (别名: wb-usage)
  workbuddy checkin [账号名]      每日签到与保活对话 (别名: wb-checkin)
  workbuddy chat [提示词] [--all]  终端快速调用模型对话 (别名: wb-chat)
  workbuddy models [--list|--json] 查看/切换可用模型与倍率 (别名: wb-models)
  workbuddy router [子命令]        容灾轮换路由网关管理 (别名: wb-router)
  workbuddy sandbox [子命令]       沙盒状态自愈与快照存储治理 (别名: wb-sandbox)
  workbuddy doctor                诊断凭据解密与运行环境 (别名: wb-doctor)
  workbuddy save <别名> [--force]  保存当前活跃账号为 Profile
  workbuddy init / rollback       开启 / 撤销全域工作区打通
  workbuddy restart               重启 WorkBuddy 客户端

详细功能与原理解析请参阅: README.md
""")

def main():
    prog_name = os.path.basename(sys.argv[0]).lower()
    clean_prog = prog_name.replace(".cmd", "").replace(".exe", "")
    args = sys.argv[1:]

    # 如果通过快捷帮助别名调用 (wb-help / workbuddy-help)
    if clean_prog in ("wb-help", "workbuddy-help") or clean_prog.endswith("-help"):
        print_help()
        return

    # 如果通过图形交互控制中心调用 (wb-tool / workbuddy-tool)
    if clean_prog in ("wb-tool", "workbuddy-tool") or clean_prog.endswith(("-tool",)):
        run_interactive_tool_cmd(args)
        return

    # 如果通过快捷别名调用
    if "login" in prog_name:
        if any(a in ("-h", "--help", "help") for a in args):
            print("用法: wb-login [账号别名] [--force] [--no-switch]")
            return
        force = any(a in ("--force", "-f", "--overwrite") for a in args)
        auto_switch = ("--no-switch" not in args)
        clean_args = [a for a in args if not a.startswith("--") and not a.startswith("-")]
        alias = clean_args[0] if clean_args else None
        run_login(alias=alias, auto_switch=auto_switch, force=force)
        return
    # 精确匹配程序名，不做子串匹配：只要安装目录里带 remove 字样就会被误判
    if clean_prog in ("wb-remove", "workbuddy-remove", "wb-rm", "workbuddy-rm"):
        sys.exit(run_remove_cmd(args))
    if "audit" in prog_name:
        if any(a in ("-h", "--help", "help") for a in args):
            print("用法: wb-audit [--force] [--interval HOURS | --daemon [HOURS]]")
            return
        force, daemon_mode, interval_hours = _parse_audit_cli_args(args)
        if daemon_mode:
            run_audit_daemon(interval_hours=interval_hours, force=force)
            return
        ok = run_audit(force=force, notify_on_expired=True)
        sys.exit(0 if ok else 1)
    if clean_prog in ("wb-list", "workbuddy-list", "wb-status", "workbuddy-status") or clean_prog.endswith(("-list", "-status")):
        if any(a in ("-h", "--help", "help") for a in args):
            print(f"用法: {prog_name} [--json]")
            return
        as_json = any(a in ("--json", "-j") for a in args)
        show_status(as_json=as_json)
        return
    if "doctor" in prog_name:
        ok = run_doctor(args)
        sys.exit(0 if ok else 1)
    if "chat" in prog_name:
        parse_and_run_chat(args)
        return
    if "checkin" in prog_name:
        with_chat = ("--no-chat" not in args)
        clean_args = [a for a in args if a != "--no-chat"]
        target = clean_args[0] if clean_args else None
        run_checkin(target, with_chat=with_chat)
        return
    if "switch" in prog_name:
        if args:
            switch_to_profile(args[0], auto_restart=True)
        else:
            interactive_menu()
        return
    if "model" in prog_name:
        run_models_cmd(args)
        return
    if "router" in prog_name:
        run_router_cmd(args)
        return
    if "sandbox" in prog_name:
        run_sandbox_cmd(args)
        return
    if clean_prog in ("wb-usage", "workbuddy-usage") or clean_prog.endswith(("-usage",)):
        run_usage_cmd(args)
        return

    if not args:
        interactive_menu()
        return

    cmd = args[0].lower()
    if cmd in ["tool", "tui", "toolbox", "box"]:
        run_interactive_tool_cmd(args[1:])
        return
    if cmd in ["--json", "-j"]:
        sub_args = args[1:]
        if not sub_args or any(s in ["list", "ls", "status", "info", "whoami"] for s in sub_args):
            show_status(as_json=True)
            return
    if cmd in ["login", "signin", "auth"]:
        sub_args = args[1:]
        if any(a in ("-h", "--help", "help") for a in sub_args):
            print("用法: workbuddy login [账号别名] [--force] [--no-switch]")
            return
        force = any(a in ("--force", "-f", "--overwrite") for a in sub_args)
        auto_switch = ("--no-switch" not in sub_args)
        clean_args = [a for a in sub_args if not a.startswith("--") and not a.startswith("-")]
        alias = clean_args[0] if clean_args else None
        run_login(alias=alias, auto_switch=auto_switch, force=force)
    elif cmd in ["audit", "verify", "health"]:
        sub_args = args[1:]
        if any(a in ("-h", "--help", "help") for a in sub_args):
            print("用法: workbuddy audit [--force] [--interval HOURS | --daemon [HOURS]]")
            return
        force, daemon_mode, interval_hours = _parse_audit_cli_args(sub_args)
        if daemon_mode:
            run_audit_daemon(interval_hours=interval_hours, force=force)
            return
        ok = run_audit(force=force, notify_on_expired=True)
        sys.exit(0 if ok else 1)
    elif cmd in ["usage", "use-stat", "credits", "credit", "pts"]:
        run_usage_cmd(args[1:])
        return
    elif cmd in ["models", "model"]:
        run_models_cmd(args[1:])
    elif cmd in ["router"]:
        run_router_cmd(args[1:])
    elif cmd in ["sandbox", "sb", "seatbelt"]:
        run_sandbox_cmd(args[1:])
    elif cmd in ["doctor", "check", "diag", "diagnose"]:
        ok = run_doctor(args[1:])
        sys.exit(0 if ok else 1)
    elif cmd in ["switch", "use"]:
        if len(args) > 1:
            switch_to_profile(args[1], auto_restart=True)
        else:
            interactive_menu()
    elif cmd in ["checkin", "check-in", "sign", "signin"]:
        with_chat = ("--no-chat" not in args)
        clean_args = [a for a in args[1:] if a != "--no-chat"]
        target = clean_args[0] if clean_args else None
        run_checkin(target, with_chat=with_chat)
    elif cmd in ["chat", "ask", "tell"]:
        parse_and_run_chat(args[1:])
    elif cmd in ["status", "info", "whoami", "list", "ls"]:
        sub_args = args[1:]
        if any(a in ("-h", "--help", "help") for a in sub_args):
            print(f"用法: workbuddy {cmd} [--json]")
            return
        as_json = any(a in ("--json", "-j") for a in sub_args)
        show_status(as_json=as_json)
    elif cmd in ["save", "backup"]:
        sub_args = args[1:]
        if any(a in ("-h", "--help", "help") for a in sub_args):
            print("用法: workbuddy save <账号别名> [--force]")
            return
        force = any(a in ("--force", "-f", "--overwrite") for a in sub_args)
        clean_args = [a for a in sub_args if not a.startswith("--") and not a.startswith("-")]
        if clean_args:
            save_current(clean_args[0], force=force)
        else:
            print(f"{COLOR_RED}请提供保存的名称，例如: workbuddy save myaccount [--force]{COLOR_RESET}")
    elif cmd in ["remove", "rm", "delete", "del", "forget"]:
        sys.exit(run_remove_cmd(args[1:]))
    elif cmd in ["init", "patch"]:
        init_shared_workspace()
    elif cmd in ["rollback", "unpatch"]:
        restore_uid = args[1] if len(args) > 1 else None
        rollback_shared_workspace(restore_uid)
    elif cmd in ["restart"]:
        restart_workbuddy()
    elif cmd in ["-v", "--version", "version"]:
        print(f"workbuddy toolkit v{VERSION}")
    elif cmd in ["-h", "--help", "help"]:
        print_help()
    else:
        profiles = get_profiles()
        # `workbuddy <别名|昵称>` 快捷切换：只接受精确匹配，避免拼错的命令被当成 UID 前缀切号
        shortcut_name, _ = resolve_profile_target(profiles, args[0], allow_uid_prefix=False, quiet=True)
        if shortcut_name:
            switch_to_profile(shortcut_name, auto_restart=True)
        else:
            print(f"{COLOR_RED}未知命令或账号: {cmd}{COLOR_RESET}")
            print_help()

if __name__ == "__main__":
    main()
