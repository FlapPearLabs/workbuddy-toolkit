def run_router_cmd(args):
    """管理 WorkBuddy 容灾轮换路由服务 (status / start / stop / restart)"""
    action = args[0].lower() if args else "status"
    sidecar_dir = find_sidecar_dir()
    if sidecar_dir not in sys.path:
        sys.path.insert(0, sidecar_dir)
    import router_engine

    cfg_file = router_engine.DEFAULT_ROUTER_CONFIG
    port = 8047
    if os.path.exists(cfg_file):
        try:
            with open(cfg_file, "r", encoding="utf-8") as f:
                port = json.load(f).get("port", 8047)
        except Exception:
            pass

    if action == "status":
        print(f"\n{COLOR_BOLD}=== WorkBuddy Failover Router 状态 ==={COLOR_RESET}")
        try:
            req = urllib.request.Request(f"http://127.0.0.1:{port}/status")
            with urllib.request.urlopen(req, timeout=2) as resp:
                data = json.loads(resp.read().decode("utf-8"))
                print(f"网关服务   : {COLOR_GREEN}运行中 (ONLINE){COLOR_RESET}")
                print(f"监听端口   : {port}")
                chain_str = " -> ".join(data.get("chain", [])) or "空 (请运行 wb-models 设置)"
                print(f"容灾梯队   : {COLOR_CYAN}{chain_str}{COLOR_RESET}")
                cooldowns = data.get("active_cooldowns", {})
                if cooldowns:
                    cd_str = ", ".join([f"{k} (剩 {v}s)" for k, v in cooldowns.items()])
                    print(f"冷却中模型 : {COLOR_YELLOW}{cd_str}{COLOR_RESET}")
                else:
                    print("冷却中模型 : 无 (所有候选均健康就绪)")
        except Exception:
            print(f"网关服务   : {COLOR_RED}未运行 (OFFLINE){COLOR_RESET}")
            print("提示: 可使用 'workbuddy router start' 启动，或配置 LaunchAgent 常驻运行。")
        print()
    elif action == "start":
        try:
            req = urllib.request.Request(f"http://127.0.0.1:{port}/health")
            with urllib.request.urlopen(req, timeout=1) as resp:
                print(f"{COLOR_YELLOW}Failover Router 已经在运行中 (http://127.0.0.1:{port}){COLOR_RESET}")
                return
        except Exception:
            pass

        plist_path = os.path.expanduser("~/Library/LaunchAgents/com.workbuddy.failover-router.plist")
        if os.path.exists(plist_path):
            subprocess.run(["launchctl", "load", "-w", plist_path], capture_output=True)
            time.sleep(0.5)
            print(f"{COLOR_GREEN}✔ 已通过 launchd 启动 Failover Router 常驻服务。{COLOR_RESET}")
        else:
            script_path = os.path.join(sidecar_dir, "router_engine.py")
            subprocess.Popen([sys.executable, script_path], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            time.sleep(0.5)
            print(f"{COLOR_GREEN}✔ 已在后台启动 Failover Router 服务 (端口: {port})。{COLOR_RESET}")
    elif action == "stop":
        plist_path = os.path.expanduser("~/Library/LaunchAgents/com.workbuddy.failover-router.plist")
        if os.path.exists(plist_path):
            subprocess.run(["launchctl", "unload", plist_path], capture_output=True)
        if sys.platform != "win32":
            subprocess.run(["pkill", "-f", "sidecar/router_engine.py"], capture_output=True)
        print(f"{COLOR_GREEN}✔ Failover Router 服务已停止。{COLOR_RESET}")
    elif action == "restart":
        run_router_cmd(["stop"])
        time.sleep(0.5)
        run_router_cmd(["start"])
    else:
        print("用法: workbuddy router [status|start|stop|restart]")

def get_log_guard_module():
    import importlib.util
    import importlib.machinery
    candidates = [
        os.path.join(os.path.dirname(os.path.abspath(__file__)), "workbuddy-log-guard"),
        os.path.expanduser("~/.workbuddy/toolkit/bin/workbuddy-log-guard"),
        os.path.expanduser("~/.local/bin/workbuddy-log-guard"),
    ]
    for c in candidates:
        if os.path.exists(c):
            try:
                loader = importlib.machinery.SourceFileLoader("workbuddy_log_guard", c)
                spec = importlib.util.spec_from_loader(loader.name, loader)
                mod = importlib.util.module_from_spec(spec)
                loader.exec_module(mod)
                return mod
            except Exception:
                pass
    return None

def run_sandbox_cmd(args):
    """管理 WorkBuddy 沙盒核心健康状态、Seatbelt 规则自愈与快照存储治理 (status / heal / clean)"""
    as_json = "--json" in args
    filtered_args = [a for a in args if a != "--json"]
    action = filtered_args[0].lower() if filtered_args else "status"
    guard = get_log_guard_module()
    if not guard:
        print(f"{COLOR_RED}错误: 无法定位 workbuddy-log-guard 模块。{COLOR_RESET}")
        sys.exit(1)

    if action == "status":
        sock = guard.find_sandbox_center_socket()
        target_uid = guard.find_active_uid()
        total_rules = 0
        has_temp_wildcard = False
        rule_status_ok = False

        if sock:
            resp = guard.send_sandbox_ipc(sock, "sandbox.rules.get_rules", {}, uid=target_uid)
            if resp and resp.get("success"):
                rule_status_ok = True
                file_rules = resp.get("data", {}).get("fileRules", [])
                total_rules = len(file_rules)
                paths = {r.get("path") for r in file_rules if isinstance(r, dict)}
                temp_paths = ["/var/folders/**", "/tmp/**"]
                has_temp_wildcard = any(p in paths for p in temp_paths)

        session_count = 0
        sessions_dir = os.path.expanduser("~/.workbuddy/workspace/sessions")
        if os.path.exists(sessions_dir):
            try:
                session_count = len([d for d in os.listdir(sessions_dir) if os.path.isdir(os.path.join(sessions_dir, d))])
            except Exception:
                pass

        gui_running = guard.is_workbuddy_gui_running()

        if as_json:
            result = {
                "sandbox_daemon": "ONLINE" if sock else "STOPPED",
                "socket": sock,
                "file_rules_count": total_rules if (sock and rule_status_ok) else None,
                "temp_wildcard_rules": has_temp_wildcard if (sock and rule_status_ok) else False,
                "sessions_count": session_count,
                "gui_running": gui_running
            }
            print(json.dumps(result, indent=2, ensure_ascii=False))
            return

        print(f"\n{COLOR_BOLD}{COLOR_CYAN}=== WorkBuddy Sandbox & Seatbelt Status ==={COLOR_RESET}\n")
        if sock:
            print(f"Sandbox daemon        : {COLOR_GREEN}ONLINE{COLOR_RESET} (socket: {sock})")
            if rule_status_ok:
                rule_color = COLOR_GREEN if total_rules < 500 else (COLOR_YELLOW if total_rules < 2000 else COLOR_RED)
                print(f"File rules count      : {rule_color}{total_rules}{COLOR_RESET}")
                wildcard_status = f"{COLOR_GREEN}ACTIVE (macOS Temp Wildcards Installed){COLOR_RESET}" if has_temp_wildcard else f"{COLOR_RED}MISSING (High Risk of Rule Explosion){COLOR_RESET}"
                print(f"Temp wildcard rules   : {wildcard_status}")
            else:
                print(f"File rules count      : {COLOR_YELLOW}UNKNOWN (IPC query timeout or denied){COLOR_RESET}")
        else:
            print(f"Sandbox daemon        : {COLOR_YELLOW}STOPPED (No active center socket){COLOR_RESET}")

        print(f"Session workspace     : {session_count} active session histories")
        print(f"WorkBuddy GUI status  : {COLOR_GREEN}RUNNING{COLOR_RESET}" if gui_running else f"WorkBuddy GUI status  : {COLOR_YELLOW}CLOSED{COLOR_RESET}")
        print()

    elif action == "heal":
        print(f"\n{COLOR_CYAN}正在检查并自愈 sandbox-center 规则与治理状态...{COLOR_RESET}")
        result = guard.heal_sandbox_center_rules()
        status = result.get("status")
        if status == "ok":
            print(f"{COLOR_GREEN}✔ 自愈完成: 总规则数 {result.get('total_rules')} 条，注入通配规则 {result.get('added_temp_rules')} 条。{COLOR_RESET}")
            if result.get("cleared_auto_grant"):
                print(f"{COLOR_GREEN}✔ 成功清理膨胀的 auto_grant 规则，消除 O(N^2) SBPL 编译锁死风险。{COLOR_RESET}")
        elif status == "no_socket":
            print(f"{COLOR_YELLOW}[提示] 未发现运行中的 sandbox-center 守护进程。{COLOR_RESET}")
        else:
            print(f"{COLOR_RED}自愈失败: {result}{COLOR_RESET}")
        print()

    elif action == "clean":
        print(f"\n{COLOR_CYAN}正在外科手术式治理 WorkBuddy 会话快照与孤儿进程...{COLOR_RESET}")
        open_files = guard.get_open_files(guard.LOG_DIR)
        if os.path.exists(guard.SESSIONS_DIR):
            open_files.update(guard.get_open_files(guard.SESSIONS_DIR))
        cleaned_sessions, freed_bytes = guard.clean_session_snapshots(guard.SESSIONS_DIR, open_files, ttl_hours=72, max_keep=10)
        cleaned_shells = guard.clean_shell_snapshots(guard.SHELL_SNAPSHOTS_DIR, ttl_hours=72)
        freed_mb = freed_bytes / (1024 * 1024)
        print(f"{COLOR_GREEN}✔ 已清理 {cleaned_sessions} 个历史会话快照与 {cleaned_shells} 个 shell 镜像，释放磁盘 {freed_mb:.2f} MB。{COLOR_RESET}")
        reap_res = guard.reap_orphaned_daemons()
        if reap_res.get("reaped"):
            print(f"{COLOR_GREEN}✔ 已终止孤儿守护进程 PIDs: {reap_res.get('pids')}{COLOR_RESET}")
        elif reap_res.get("reason") == "gui_running":
            print("  (WorkBuddy GUI 运行中，跳过孤儿进程回收)")
        elif reap_res.get("reason") == "user_workload_active":
            print("  (检测到用户活跃进程，跳过守护进程回收以保护工作现场)")
        elif reap_res.get("reason") == "sandbox_cli_active":
            print("  (检测到沙盒中存在活跃任务，跳过守护进程回收)")
        print()

    else:
        print("用法: workbuddy sandbox [status|heal|clean] [--json] (别名: wb-sandbox)")

