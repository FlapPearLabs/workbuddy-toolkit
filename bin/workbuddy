#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
WorkBuddy Multi-Account Manager & Automation Toolkit (workbuddy CLI)
https://github.com/FlapPearLabs/workbuddy-toolkit

Features:
- Zero-Scan Account Switcher: Log in once, save the profile, and NEVER scan QR code again when switching.
- Cross-Platform Support: Full support for macOS, Linux, and Windows.
- Shared Workspace & Session Sync: Universal workspace trees and chat histories across all accounts.
- Automated Daily Check-in: Headless status probe and credit claims via Tencent backend endpoints.
- Automated Daily Dialogue: Auto-fires minimal prompt to maintain continuous dialogue rewards with lowest multiplier / free models.
- Direct CLI Chat: Talk directly with WorkBuddy models in terminal without Electron UI overhead.
- Auto Profile Discovery: Automatically detects and registers newly logged-in accounts.
"""

import os
import sys
import json
import time
import sqlite3
import subprocess
import urllib.request
import urllib.error
import re
import shutil
import base64
import unicodedata
from datetime import datetime

VERSION = "0.3.1"
PREFERRED_CHAT_MODELS = ["hy3", "deepseek-v4-flash", "auto", "glm-5v-turbo"]

# Windows 控制台编码安全处理与 ANSI 颜色初始化
if sys.platform == "win32":
    if hasattr(sys.stdout, "reconfigure"):
        sys.stdout.reconfigure(encoding="utf-8", errors="replace")
    if hasattr(sys.stderr, "reconfigure"):
        sys.stderr.reconfigure(encoding="utf-8", errors="replace")
    try:
        import ctypes
        kernel32 = ctypes.windll.kernel32
        # ENABLE_PROCESSED_OUTPUT (1) | ENABLE_WRAP_AT_EOL_OUTPUT (2) | ENABLE_VIRTUAL_TERMINAL_PROCESSING (4) = 7
        kernel32.SetConsoleMode(kernel32.GetStdHandle(-11), 7)
    except Exception:
        pass

def get_auth_file():
    if sys.platform == "darwin":
        candidates = [
            os.path.expanduser("~/Library/Application Support/CodeBuddyExtension/Data/Public/auth/workbuddy-desktop.info"),
            os.path.expanduser("~/.workbuddy/auth/workbuddy-desktop.info"),
        ]
    elif sys.platform == "win32":
        appdata = os.environ.get("APPDATA", os.path.expanduser("~\\AppData\\Roaming"))
        localappdata = os.environ.get("LOCALAPPDATA", os.path.expanduser("~\\AppData\\Local"))
        userprofile = os.environ.get("USERPROFILE", os.path.expanduser("~"))
        candidates = [
            os.path.join(appdata, "CodeBuddyExtension", "Data", "Public", "auth", "workbuddy-desktop.info"),
            os.path.join(localappdata, "CodeBuddyExtension", "Data", "Public", "auth", "workbuddy-desktop.info"),
            os.path.join(userprofile, ".workbuddy", "auth", "workbuddy-desktop.info"),
        ]
    else:  # Linux & others
        config_home = os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config"))
        data_home = os.environ.get("XDG_DATA_HOME", os.path.expanduser("~/.local/share"))
        candidates = [
            os.path.join(config_home, "CodeBuddyExtension", "Data", "Public", "auth", "workbuddy-desktop.info"),
            os.path.join(data_home, "CodeBuddyExtension", "Data", "Public", "auth", "workbuddy-desktop.info"),
            os.path.expanduser("~/.workbuddy/auth/workbuddy-desktop.info"),
        ]
    for path in candidates:
        if os.path.exists(path):
            return path
    return candidates[0]

def get_db_file():
    return os.path.expanduser("~/.workbuddy/workbuddy.db")

def get_profiles_dir():
    return os.path.expanduser("~/.workbuddy/auth_profiles")

AUTH_FILE = get_auth_file()
PROFILES_DIR = get_profiles_dir()
DB_FILE = get_db_file()

HAS_COLOR = sys.platform != "win32" or "WT_SESSION" in os.environ or os.environ.get("TERM_PROGRAM") or sys.stdout.isatty()
COLOR_GREEN = "\033[92m" if HAS_COLOR else ""
COLOR_YELLOW = "\033[93m" if HAS_COLOR else ""
COLOR_CYAN = "\033[96m" if HAS_COLOR else ""
COLOR_RED = "\033[91m" if HAS_COLOR else ""
COLOR_BOLD = "\033[1m" if HAS_COLOR else ""
COLOR_RESET = "\033[0m" if HAS_COLOR else ""

# ==============================================================================
# Credential Compatibility Layer (支持旧版明文凭据与 WorkBuddy 5.6+ 加密凭据)
# 核心原则：DO NOT DECRYPT FOR STORAGE（持久化保留原始格式，仅在请求时临时内存解密）
# 实际实现与安全边界保证：
# - plaintext credential 不主动持久化
# - 不写 auth profile
# - 不写临时文件
# - 不写日志
# - 不主动打印
# - 仅在当前进程/子进程内瞬态使用
# 注意：JS Buffer 的 key/plaintext fill(0) 虽尽力擦除底层缓冲区，但 JS string、
# JSON 序列化传输以及 Python bytes/string 受语言不可变对象限制，无法保证立即物理 zeroization。
# ==============================================================================

AUTH_INPUT_LIMIT = 65536
AUTH_OUTPUT_LIMIT = 65536
TOKEN_LIMIT = 32768
NICKNAME_LIMIT = 256
AUTH_HELPER_TIMEOUT = 10.0

AUTH_REASONS = {
    "INVALID_FORMAT": "凭据格式无效或信封数据损坏",
    "UNSUPPORTED_ENVELOPE": "不支持的加密凭据格式（仅支持 suite 1 / sym-v1）",
    "RUNTIME_NOT_FOUND": "未检测到可用的 WorkBuddy 客户端运行时，请配置 WORKBUDDY_EXE 环境变量",
    "INVALID_RUNTIME_PATH": "WORKBUDDY_EXE 指定的文件不存在或不可执行",
    "RUNTIME_UNAVAILABLE": "客户端运行时不支持所需的原生存储解密接口",
    "KEY_MISMATCH": "凭据与当前 WorkBuddy 运行时的密钥不匹配",
    "DECRYPT_FAILED": "加密凭据认证或解密失败",
    "HELPER_TIMEOUT": "凭据解密助手子进程执行超时",
    "HELPER_PROTOCOL": "客户端解密通信协议异常",
    "AUTH_CREDENTIAL_UNRESOLVED": "凭据解析失败，无法获取有效认证令牌",
}

# 最小 Node.js 解密助手（通过 stdin/stdout 安全通信，瞬态内存解密，绝不落盘，绝不打印）
AUTH_HELPER_JS = r"""
'use strict';
const crypto = require('crypto');
const inputLimit = 65536;
const failure = reason => { throw {reason}; };
const object = x => x !== null && typeof x === 'object' && !Array.isArray(x);
function base64(value, length) {
  if (typeof value !== 'string' || value.length > inputLimit) failure('INVALID_FORMAT');
  const bytes = Buffer.from(value, 'base64');
  if (bytes.toString('base64') !== value || (length !== undefined && bytes.length !== length))
    failure('INVALID_FORMAT');
  return bytes;
}
function utf8(bytes) {
  const text = bytes.toString('utf8');
  if (!Buffer.from(text, 'utf8').equals(bytes)) failure('INVALID_FORMAT');
  return text;
}
function decode(value) {
  if (!object(value) || Object.keys(value).sort().join(',') !== '$wbEncrypted,envelope' || value.$wbEncrypted !== 1)
    failure('UNSUPPORTED_ENVELOPE');
  let envelope;
  try { envelope = JSON.parse(utf8(base64(value.envelope))); }
  catch (e) { failure(e.reason || 'INVALID_FORMAT'); }
  if (!object(envelope) || !Number.isInteger(envelope.suite)) failure('INVALID_FORMAT');
  if (envelope.suite !== 1) failure('UNSUPPORTED_ENVELOPE');
  if (Object.keys(envelope).sort().join(',') !== 'authTag,ciphertext,keyId,nonce,suite' ||
      typeof envelope.keyId !== 'string' || !/^[0-9a-f]{16}$/.test(envelope.keyId)) failure('INVALID_FORMAT');
  return {keyId: envelope.keyId, nonce: base64(envelope.nonce, 12),
    tag: base64(envelope.authTag, 16), ciphertext: base64(envelope.ciphertext)};
}
function nativeStorage() {
  try {
    const storage = process._linkedBinding('electron_browser_workbuddy_storage');
    if (typeof storage.loggerGet !== 'function') failure('RUNTIME_UNAVAILABLE');
    return storage;
  } catch (_) { failure('RUNTIME_UNAVAILABLE'); }
}
function decrypt(envelope) {
  let payload;
  try { payload = JSON.parse(nativeStorage().loggerGet()); }
  catch (_) { failure('RUNTIME_UNAVAILABLE'); }
  let key;
  let plaintext;
  try {
    if (!object(payload) || payload.version !== 1) failure('RUNTIME_UNAVAILABLE');
    let secret;
    try { secret = base64(payload.atRestSecretKey, 32); }
    catch (_) { failure('RUNTIME_UNAVAILABLE'); }
    const empty = secret.every(b => b === 0);
    secret.fill(0);
    if (empty) failure('RUNTIME_UNAVAILABLE');
    key = crypto.createHash('sha256').update(payload.atRestSecretKey, 'utf8').digest();
    payload = null;
    if (crypto.createHash('sha256').update(key).digest('hex').slice(0, 16) !== envelope.keyId)
      failure('KEY_MISMATCH');
    const lp = s => {
      const bytes = Buffer.from(s, 'utf8');
      const length = Buffer.alloc(4); length.writeUInt32BE(bytes.length);
      return Buffer.concat([length, bytes]);
    };
    const aad = Buffer.concat([Buffer.from('WB-AAD\0', 'ascii'), Buffer.from([1]),
      lp('WBEV1'), lp('sym-v1'), Buffer.from([0, 0, 0, 1]), lp(envelope.keyId), Buffer.from([2, 0, 0])]);
    try {
      const cipher = crypto.createDecipheriv('aes-256-gcm', key, envelope.nonce, {authTagLength: 16});
      cipher.setAAD(aad); cipher.setAuthTag(envelope.tag);
      plaintext = Buffer.concat([cipher.update(envelope.ciphertext), cipher.final()]);
    } catch (_) { failure('DECRYPT_FAILED'); }
    const text = utf8(plaintext);
    if (!text.length || text.length > 32768)
      failure('INVALID_FORMAT');
    return text;
  } finally {
    if (key) key.fill(0);
    if (plaintext) plaintext.fill(0);
  }
}
let chunks = [], size = 0;
function reply(value) {
  process.stdout.write(JSON.stringify({version: 1, ...value}), () => process.exit(value.ok ? 0 : 1));
}
process.stdin.on('data', chunk => {
  size += chunk.length;
  if (size > inputLimit) reply({ok: false, reason: 'INVALID_FORMAT'});
  else chunks.push(chunk);
});
process.stdin.on('error', () => reply({ok: false, reason: 'HELPER_PROTOCOL'}));
process.stdin.on('end', () => {
  try {
    const request = JSON.parse(utf8(Buffer.concat(chunks))); chunks = [];
    if (!object(request) || request.version !== 1) failure('HELPER_PROTOCOL');
    if (request.operation === 'probe') {
      nativeStorage();
      if (!crypto.getCiphers().includes('aes-256-gcm')) failure('RUNTIME_UNAVAILABLE');
      reply({ok: true, electron: process.versions.electron || 'unknown'});
    } else if (request.operation === 'decrypt') {
      const decrypted = decrypt(decode(request.value));
      reply({ok: true, value: decrypted, accessToken: decrypted});
    } else failure('HELPER_PROTOCOL');
  } catch (e) {
    const reasons = ['INVALID_FORMAT','UNSUPPORTED_ENVELOPE','RUNTIME_UNAVAILABLE',
      'KEY_MISMATCH','DECRYPT_FAILED','HELPER_PROTOCOL'];
    reply({ok: false, reason: reasons.includes(e.reason) ? e.reason : 'HELPER_PROTOCOL'});
  }
});
"""

class CredentialError(Exception):
    def __init__(self, reason, message=None):
        self.reason = reason
        self.message = message or AUTH_REASONS.get(reason, f"认证错误: {reason}")
        super().__init__(self.message)

def is_valid_token_string(token):
    return (
        isinstance(token, str)
        and 0 < len(token) <= TOKEN_LIMIT
        and re.fullmatch(r"[A-Za-z0-9._~+\/-]+=*", token) is not None
    )

def is_valid_nickname_string(nick):
    """
    根据 field_name="nickname" 进行最小字段级验证：
    - 必须为合法非空字符串，长度在 1 到 256 字符之间，且不全为空白
    - 允许合法 UTF-8 Unicode 文本（包含中文、日文、Emoji 等）以及包含正常空格的昵称
    - 拒绝 NUL (\x00) 及不可见控制字符 (ord < 32 或 Unicode 类别 Cc / Cs)
    - 不得应用 accessToken 专用字符集 regex
    """
    if not isinstance(nick, str):
        return False
    if not (0 < len(nick) <= NICKNAME_LIMIT) or not nick.strip():
        return False
    for ch in nick:
        if ord(ch) < 32 or unicodedata.category(ch) in ("Cc", "Cs"):
            return False
    return True

def is_encrypted_credential(value):
    return (
        isinstance(value, dict)
        and value.get("$wbEncrypted") == 1
        and "envelope" in value
    )

def check_token_format(value):
    """
    检查 token 格式:
    - 'plaintext' (有效字符串)
    - 'sym-v1' (有效 suite 1 加密信封)
    - 'unsupported' (不支持的加密格式)
    - 'malformed' (格式损坏)
    - 'missing' (空值)
    """
    if value is None:
        return "missing"
    if isinstance(value, str):
        return "plaintext" if is_valid_token_string(value) else "malformed"
    if isinstance(value, dict):
        if set(value.keys()) != {"$wbEncrypted", "envelope"} or value.get("$wbEncrypted") != 1:
            return "unsupported"
        encoded = value.get("envelope")
        if not isinstance(encoded, str) or not (0 < len(encoded) <= AUTH_INPUT_LIMIT - 1024):
            return "malformed"
        try:
            raw = base64.b64decode(encoded, validate=True)
            if base64.b64encode(raw).decode("ascii") != encoded:
                return "malformed"
            envelope = json.loads(raw.decode("utf-8"))
            if not isinstance(envelope, dict):
                return "malformed"
            suite = envelope.get("suite")
            if suite != 1:
                return "unsupported"
            if set(envelope.keys()) != {"suite", "keyId", "nonce", "authTag", "ciphertext"}:
                return "malformed"
            if not isinstance(envelope.get("keyId"), str) or not re.fullmatch(r"[0-9a-f]{16}", envelope["keyId"]):
                return "malformed"
            for field, length in (("nonce", 12), ("authTag", 16), ("ciphertext", None)):
                data = envelope.get(field)
                if not isinstance(data, str):
                    return "malformed"
                dec = base64.b64decode(data, validate=True)
                if base64.b64encode(dec).decode("ascii") != data or (length is not None and len(dec) != length):
                    return "malformed"
            return "sym-v1"
        except Exception:
            return "malformed"
    return "malformed"

def find_workbuddy_runtime():
    """
    定位本机 WorkBuddy 可执行文件/运行时路径。
    优先读取 WORKBUDDY_EXE 环境变量，其次按操作系统探测标准安装路径。
    """
    override = os.environ.get("WORKBUDDY_EXE")
    if override:
        path = os.path.abspath(os.path.expanduser(override))
        if os.path.isfile(path) and (sys.platform == "win32" or os.access(path, os.X_OK)):
            return path
        raise CredentialError("INVALID_RUNTIME_PATH")

    candidates = []
    if sys.platform == "darwin":
        for root in ("/Applications", os.path.expanduser("~/Applications")):
            app_bundle = os.path.join(root, "WorkBuddy.app")
            plist_path = os.path.join(app_bundle, "Contents", "Info.plist")
            if os.path.exists(plist_path):
                exe_name = "Electron"
                try:
                    import plistlib
                    with open(plist_path, "rb") as f:
                        info = plistlib.load(f)
                        exe_name = info.get("CFBundleExecutable", "Electron")
                except Exception:
                    pass
                candidates.append(os.path.join(app_bundle, "Contents", "MacOS", exe_name))
            candidates.append(os.path.join(app_bundle, "Contents", "MacOS", "Electron"))
    elif sys.platform == "win32":
        local = os.environ.get("LOCALAPPDATA", os.path.expanduser("~\\AppData\\Local"))
        candidates.append(os.path.join(local, "Programs", "WorkBuddy", "WorkBuddy.exe"))
        candidates.append(os.path.join(local, "Programs", "workbuddy", "WorkBuddy.exe"))
        for pvar in ("ProgramFiles", "ProgramFiles(x86)"):
            pval = os.environ.get(pvar)
            if pval:
                candidates.append(os.path.join(pval, "WorkBuddy", "WorkBuddy.exe"))
        which_exe = shutil.which("WorkBuddy.exe") or shutil.which("workbuddy.exe")
        if which_exe:
            candidates.append(which_exe)
    else:  # Linux
        which_wb = shutil.which("workbuddy")
        if which_wb:
            candidates.append(which_wb)
        candidates.extend([
            "/opt/WorkBuddy/workbuddy",
            "/opt/workbuddy/workbuddy",
            os.path.expanduser("~/.local/bin/workbuddy")
        ])

    for p in candidates:
        if p and os.path.isfile(p) and (sys.platform == "win32" or os.access(p, os.X_OK)):
            return os.path.abspath(p)

    raise CredentialError("RUNTIME_NOT_FOUND")

def run_native_resolver(runtime_exe, request_payload):
    """
    通过子进程与 WorkBuddy 运行时进行安全通信。
    采用标准输入/输出流管道传递请求与结果，不产生临时文件，绝不在异常中回显凭据。
    """
    data = json.dumps(dict(request_payload, version=1), ensure_ascii=True).encode("ascii")
    if len(data) > AUTH_INPUT_LIMIT:
        raise CredentialError("INVALID_FORMAT")

    # 屏蔽外部 Node/Electron 注入环境变量，开启 ELECTRON_RUN_AS_NODE
    clean_env = {
        k: v for k, v in os.environ.items()
        if not k.upper().startswith(("NODE_", "ELECTRON_", "WORKBUDDY_"))
    }
    clean_env["ELECTRON_RUN_AS_NODE"] = "1"

    creationflags = getattr(subprocess, "CREATE_NO_WINDOW", 0) if sys.platform == "win32" else 0

    try:
        proc = subprocess.Popen(
            [runtime_exe, "-e", AUTH_HELPER_JS],
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            env=clean_env,
            shell=False,
            creationflags=creationflags
        )
    except OSError:
        raise CredentialError("RUNTIME_UNAVAILABLE")

    try:
        stdout_data, stderr_data = proc.communicate(input=data, timeout=AUTH_HELPER_TIMEOUT)
    except subprocess.TimeoutExpired:
        proc.kill()
        proc.wait()
        raise CredentialError("HELPER_TIMEOUT")

    if len(stdout_data) > AUTH_OUTPUT_LIMIT:
        raise CredentialError("HELPER_PROTOCOL")

    try:
        reply = json.loads(stdout_data.decode("utf-8"))
    except Exception:
        raise CredentialError("HELPER_PROTOCOL")

    if not isinstance(reply, dict) or reply.get("version") != 1:
        raise CredentialError("HELPER_PROTOCOL")

    if not reply.get("ok"):
        reason = reply.get("reason", "HELPER_PROTOCOL")
        raise CredentialError(reason if reason in AUTH_REASONS else "HELPER_PROTOCOL")

    if proc.returncode != 0:
        raise CredentialError("HELPER_PROTOCOL")

    return reply

def resolve_credential_field(raw_value, field_name="accessToken"):
    """
    解析凭据字段为明文字符串：
    - Case 1: 明文字符串 -> 按 field_name 校验有效性后直接返回
    - Case 2: $wbEncrypted 加密信封 -> 调用 WorkBuddy 本地运行时解密，按 field_name 校验有效性后返回瞬态字符串
    - Case 3: 损坏或不受支持格式 -> Fail closed (抛出 CredentialError)
    - Case 4: 运行时不可用 -> Fail closed (抛出 CredentialError)
    """
    if isinstance(raw_value, str):
        val = raw_value
    elif isinstance(raw_value, dict):
        fmt = check_token_format(raw_value)
        if fmt == "sym-v1":
            runtime = find_workbuddy_runtime()
            reply = run_native_resolver(runtime, {"operation": "decrypt", "value": raw_value})
            val = reply.get("value")
            if val is None:
                val = reply.get("accessToken")
            if not isinstance(val, str):
                raise CredentialError("INVALID_FORMAT")
        elif fmt == "unsupported":
            raise CredentialError("UNSUPPORTED_ENVELOPE")
        else:
            raise CredentialError("INVALID_FORMAT")
    else:
        raise CredentialError("INVALID_FORMAT")

    if field_name == "nickname":
        if not is_valid_nickname_string(val):
            raise CredentialError("INVALID_FORMAT")
        return val
    else:
        # accessToken 及其他鉴权凭据字段严格使用 is_valid_token_string 校验，修 nickname 不得放宽 accessToken
        if not is_valid_token_string(val):
            raise CredentialError("INVALID_FORMAT")
        return val

def get_display_nickname(account_data, default_name=""):
    """
    提取安全的显示昵称，杜绝 dict.lower() crash。
    fallback 顺序:
    1. plaintext 昵称（若为合法字符串且通过 is_valid_nickname_string）
    2. 如果昵称是加密对象，尝试安全解密并通过 is_valid_nickname_string 校验；失败则 fallback
    3. account uin
    4. account uid 前 8 位
    5. default_name
    """
    if not isinstance(account_data, dict):
        return str(default_name) if default_name else "未知用户"

    nick = account_data.get("nickname")
    if isinstance(nick, str) and is_valid_nickname_string(nick):
        return nick.strip()

    if is_encrypted_credential(nick):
        try:
            resolved = resolve_credential_field(nick, field_name="nickname")
            if isinstance(resolved, str) and is_valid_nickname_string(resolved):
                return resolved.strip()
        except Exception:
            pass

    uin = account_data.get("uin")
    if uin not in (None, ""):
        return str(uin).strip()

    uid = account_data.get("uid")
    if uid not in (None, ""):
        clean_uid = str(uid).strip()
        return clean_uid[:8] if len(clean_uid) >= 8 else clean_uid

    return str(default_name) if default_name else "未知用户"

def get_active_account():
    if not os.path.exists(AUTH_FILE):
        return None
    try:
        with open(AUTH_FILE, "r", encoding="utf-8") as f:
            return json.load(f)
    except Exception:
        return None

def get_profiles():
    os.makedirs(PROFILES_DIR, exist_ok=True)
    profiles = {}
    for fname in sorted(os.listdir(PROFILES_DIR)):
        if fname.endswith(".info"):
            name = fname[:-5]
            fpath = os.path.join(PROFILES_DIR, fname)
            try:
                with open(fpath, "r", encoding="utf-8") as f:
                    data = json.load(f)
                    acc = data.get("account", {}) if isinstance(data, dict) else {}
                    nick = get_display_nickname(acc, default_name=name)
                    profiles[name] = {
                        "path": fpath,
                        "data": data,
                        "uid": acc.get("uid", "") if isinstance(acc, dict) else "",
                        "nickname": nick,
                        "uin": acc.get("uin", "") if isinstance(acc, dict) else "",
                        "expiresAt": data.get("auth", {}).get("expiresAt", 0) if isinstance(data, dict) and isinstance(data.get("auth"), dict) else 0,
                        "refreshExpiresAt": data.get("auth", {}).get("refreshExpiresAt", 0) if isinstance(data, dict) and isinstance(data.get("auth"), dict) else 0
                    }
            except Exception:
                pass
    return profiles

def format_timestamp(ts):
    if not ts:
        return "未知"
    try:
        dt = datetime.fromtimestamp(ts / 1000)
        return dt.strftime("%Y-%m-%d %H:%M:%S")
    except Exception:
        return str(ts)

def sync_active_token_to_profiles():
    active_data = get_active_account()
    if not active_data:
        return
    active_uid = active_data.get("account", {}).get("uid")
    if not active_uid:
        return

    profiles = get_profiles()
    for name, p in profiles.items():
        if p["uid"] == active_uid:
            try:
                with open(p["path"], "w", encoding="utf-8") as f:
                    json.dump(active_data, f, indent=2, ensure_ascii=False)
                if sys.platform != "win32":
                    os.chmod(p["path"], 0o600)
            except Exception:
                pass

def init_shared_workspace():
    """Inject SQLite triggers so all accounts share workspace sessions seamlessly."""
    if not os.path.exists(DB_FILE):
        print(f"{COLOR_RED}错误: 未找到 WorkBuddy 数据库 ({DB_FILE}){COLOR_RESET}")
        return False

    print(f"正在配置数据库以支持多账号工作区互通...")
    try:
        con = sqlite3.connect(DB_FILE)
        cur = con.cursor()
        
        # 1. 统一历史会话 user_id 为 ''
        cur.execute("UPDATE sessions SET user_id = '' WHERE user_id IS NOT NULL AND user_id != '';")
        
        # 2. 建立共享触发器
        cur.execute("""
        CREATE TRIGGER IF NOT EXISTS trg_sessions_force_shared_insert
        AFTER INSERT ON sessions
        WHEN NEW.user_id != '' AND NEW.user_id IS NOT NULL
        BEGIN
            UPDATE sessions SET user_id = '' WHERE id = NEW.id;
        END;
        """)
        cur.execute("""
        CREATE TRIGGER IF NOT EXISTS trg_sessions_force_shared_update
        AFTER UPDATE OF user_id ON sessions
        WHEN NEW.user_id != '' AND NEW.user_id IS NOT NULL
        BEGIN
            UPDATE sessions SET user_id = '' WHERE id = NEW.id;
        END;
        """)
        con.commit()
        con.close()
        print(f"{COLOR_GREEN}✔ 全域会话共享触发器已成功激活！所有账号将共享相同的工作区和历史记录。{COLOR_RESET}")
        return True
    except Exception as e:
        print(f"{COLOR_RED}配置失败: {e}{COLOR_RESET}")
        return False

def rollback_shared_workspace(restore_uid=None):
    """Remove SQLite triggers and optionally re-isolate sessions."""
    if not os.path.exists(DB_FILE):
        return False
    try:
        con = sqlite3.connect(DB_FILE)
        cur = con.cursor()
        cur.execute("DROP TRIGGER IF EXISTS trg_sessions_force_shared_insert;")
        cur.execute("DROP TRIGGER IF EXISTS trg_sessions_force_shared_update;")
        if restore_uid:
            cur.execute("UPDATE sessions SET user_id = ? WHERE user_id = '';", (restore_uid,))
        con.commit()
        con.close()
        print(f"{COLOR_GREEN}✔ 共享触发器已移除，已恢复单账号数据隔离。{COLOR_RESET}")
        return True
    except Exception as e:
        print(f"{COLOR_RED}回滚失败: {e}{COLOR_RESET}")
        return False

def show_status():
    active_data = get_active_account()
    profiles = get_profiles()
    print(f"\n{COLOR_BOLD}{COLOR_CYAN}=== WorkBuddy 账号状态 ({sys.platform}) ==={COLOR_RESET}")
    if not active_data:
        print(f"{COLOR_YELLOW}当前未检测到活跃的登录凭证。{COLOR_RESET}")
    else:
        acc = active_data.get("account", {}) if isinstance(active_data, dict) else {}
        auth = active_data.get("auth", {}) if isinstance(active_data, dict) else {}
        uid = acc.get("uid", "") if isinstance(acc, dict) else ""
        nickname = get_display_nickname(acc, default_name="未命名")
        raw_token = auth.get("accessToken") if isinstance(auth, dict) else None
        token_fmt = check_token_format(raw_token)
        expires = format_timestamp(auth.get("expiresAt", 0) if isinstance(auth, dict) else 0)
        refresh_expires = format_timestamp(auth.get("refreshExpiresAt", 0) if isinstance(auth, dict) else 0)

        match_name = None
        for name, p in profiles.items():
            if p["uid"] == uid:
                match_name = name
                break

        display_name = f"{nickname} ({match_name})" if match_name else nickname
        print(f"当前活跃账号: {COLOR_BOLD}{COLOR_GREEN}{display_name}{COLOR_RESET}")
        print(f"账号 UID    : {uid}")
        print(f"凭证存储格式: {token_fmt}")
        print(f"Token 有效期: {expires}")
        print(f"刷新令牌过期: {refresh_expires}")

    print(f"\n已保存的账号凭证库 ({len(profiles)} 个):")
    for name, p in profiles.items():
        is_active = active_data and isinstance(active_data, dict) and active_data.get("account", {}).get("uid") == p["uid"]
        tag = f"{COLOR_GREEN}[当前活动]{COLOR_RESET}" if is_active else "         "
        masked_uid = f"{p['uid'][:8]}..." if len(p["uid"]) > 8 else p["uid"]
        p_tok = p["data"].get("auth", {}).get("accessToken") if isinstance(p.get("data"), dict) and isinstance(p["data"].get("auth"), dict) else None
        p_fmt = check_token_format(p_tok)
        print(f" {tag} • {COLOR_BOLD}{name:<12}{COLOR_RESET} 昵称: {p['nickname']} (UID: {masked_uid}) [{p_fmt}] 有效期至: {format_timestamp(p['expiresAt'])}")
    print()

def restart_workbuddy():
    print(f"{COLOR_YELLOW}正在重启 WorkBuddy 客户端以生效凭证...{COLOR_RESET}")
    if sys.platform == "darwin":
        try:
            subprocess.run(["osascript", "-e", 'quit app "WorkBuddy"'], stderr=subprocess.DEVNULL, stdout=subprocess.DEVNULL)
        except Exception:
            pass
        time.sleep(1.5)
        res = subprocess.run(["pgrep", "-f", "WorkBuddy.app"], stdout=subprocess.PIPE, text=True)
        if res.stdout.strip():
            subprocess.run(["pkill", "-f", "WorkBuddy.app"], stderr=subprocess.DEVNULL)
            time.sleep(1)
        subprocess.run(["open", "-a", "WorkBuddy"])
    elif sys.platform == "win32":
        try:
            subprocess.run(["taskkill", "/f", "/im", "WorkBuddy.exe"], stderr=subprocess.DEVNULL, stdout=subprocess.DEVNULL)
        except Exception:
            pass
        time.sleep(1.5)
        possible_paths = [
            os.path.expandvars(r"%LOCALAPPDATA%\Programs\workbuddy\WorkBuddy.exe"),
            os.path.expandvars(r"%LOCALAPPDATA%\Programs\WorkBuddy\WorkBuddy.exe"),
            os.path.expandvars(r"%PROGRAMFILES%\WorkBuddy\WorkBuddy.exe"),
            os.path.expandvars(r"%PROGRAMFILES(X86)%\WorkBuddy\WorkBuddy.exe"),
            shutil.which("WorkBuddy.exe"),
            shutil.which("workbuddy.exe"),
        ]
        started = False
        for p in possible_paths:
            if p and os.path.exists(p) and os.path.isfile(p):
                if hasattr(os, "startfile"):
                    os.startfile(p)
                else:
                    subprocess.Popen([p], shell=True)
                started = True
                break
        if not started:
            subprocess.Popen(["start", "workbuddy"], shell=True)
    else:  # Linux
        try:
            subprocess.run(["pkill", "-f", "-i", "workbuddy"], stderr=subprocess.DEVNULL)
        except Exception:
            pass
        time.sleep(1.5)
        possible_paths = [
            shutil.which("workbuddy"),
            "/usr/bin/workbuddy",
            "/usr/local/bin/workbuddy",
            "/opt/apps/workbuddy/workbuddy",
            "/opt/workbuddy/workbuddy",
            "/opt/WorkBuddy/workbuddy",
            os.path.expanduser("~/.local/bin/workbuddy"),
        ]
        started = False
        for p in possible_paths:
            if p and os.path.exists(p) and os.path.isfile(p):
                subprocess.Popen([p], start_new_session=True)
                started = True
                break
        if not started:
            subprocess.Popen(["workbuddy"], start_new_session=True)

    print(f"{COLOR_GREEN}✔ WorkBuddy 已成功重启！{COLOR_RESET}")

def switch_to_profile(target_name, auto_restart=True):
    profiles = get_profiles()
    target = None
    for name, p in profiles.items():
        if name.lower() == target_name.lower() or p["nickname"].lower() == target_name.lower() or p["uid"].startswith(target_name):
            target = p
            target_name = name
            break

    if not target:
        print(f"{COLOR_RED}错误: 未找到名为 '{target_name}' 的账号凭证。{COLOR_RESET}")
        print(f"可用账号列表: {', '.join(profiles.keys())}")
        return False

    active_data = get_active_account()
    if active_data and active_data.get("account", {}).get("uid") == target["uid"]:
        print(f"{COLOR_GREEN}当前已处于账号 '{target_name}' ({target['nickname']})，无需切换。{COLOR_RESET}")
        return True

    print(f"1. 正在同步当前账号最新 Token 到本地备份库...")
    sync_active_token_to_profiles()

    print(f"2. 正在激活账号: {COLOR_BOLD}{COLOR_GREEN}{target_name} ({target['nickname']}){COLOR_RESET} ...")
    os.makedirs(os.path.dirname(AUTH_FILE), exist_ok=True)
    tmp_file = AUTH_FILE + ".tmp"
    with open(tmp_file, "w", encoding="utf-8") as f:
        json.dump(target["data"], f, indent=2, ensure_ascii=False)
    if sys.platform != "win32":
        os.chmod(tmp_file, 0o600)
    
    try:
        os.replace(tmp_file, AUTH_FILE)
    except PermissionError:
        # Windows: 若运行中的客户端锁定了凭证文件，先关闭进程再替换
        if sys.platform == "win32":
            print(f"{COLOR_YELLOW}检测到凭证文件被客户端锁定，正在提前关闭 WorkBuddy 进程以释放文件锁...{COLOR_RESET}")
            subprocess.run(["taskkill", "/f", "/im", "WorkBuddy.exe"], stderr=subprocess.DEVNULL, stdout=subprocess.DEVNULL)
            time.sleep(1.2)
            os.replace(tmp_file, AUTH_FILE)
        else:
            raise

    marker_file = os.path.join(os.path.dirname(AUTH_FILE), "workbuddy-desktop.logout-marker")
    if os.path.exists(marker_file):
        try:
            os.remove(marker_file)
        except Exception:
            pass

    if os.path.exists(DB_FILE):
        try:
            con = sqlite3.connect(DB_FILE)
            cur = con.cursor()
            cur.execute("UPDATE automations SET owner_user_id = ? WHERE deleted_at IS NULL;", (target["uid"],))
            con.commit()
            con.close()
        except Exception:
            pass

    print(f"{COLOR_GREEN}✔ 凭证已成功切换至: {target_name} ({target['nickname']}) (免扫码生效){COLOR_RESET}")

    if auto_restart:
        restart_workbuddy()
    else:
        print(f"{COLOR_YELLOW}提示: 请在 WorkBuddy 窗口中刷新或重启客户端以加载新账号。{COLOR_RESET}")
    return True

def send_chat_message(token, uid, prompt="请回复：你好", model=None, timeout=15):
    """
    通过底层原生 HTTP SSE 接口向指定账号发送对话，触发每日连续对话奖励。
    优先免费/最低倍率模型，遇异常自动向下 fallback。
    """
    if not isinstance(token, str) or not is_valid_token_string(token):
        return {"success": False, "error": "AUTH_CREDENTIAL_UNRESOLVED: Token 非有效字符串"}

    models_to_try = [model] if model else PREFERRED_CHAT_MODELS
    last_err = None

    for m in models_to_try:
        payload = json.dumps({
            "model": m,
            "messages": [{"role": "user", "content": prompt}],
            "stream": True
        }).encode("utf-8")

        req = urllib.request.Request(
            "https://copilot.tencent.com/v2/chat/completions",
            data=payload,
            headers={
                "Content-Type": "application/json",
                "Accept": "text/event-stream",
                "Authorization": f"Bearer {token}",
                "X-User-Id": str(uid),
                "User-Agent": "WorkBuddy/5.5.3"
            }
        )

        try:
            with urllib.request.urlopen(req, timeout=timeout) as resp:
                full_text = []
                for line in resp:
                    line_str = line.decode("utf-8", errors="ignore").strip()
                    if line_str.startswith("data: "):
                        data_part = line_str[6:]
                        if data_part == "[DONE]":
                            break
                        try:
                            chunk = json.loads(data_part)
                            delta = chunk.get("choices", [{}])[0].get("delta", {})
                            content = delta.get("content", "")
                            if content:
                                full_text.append(content)
                        except Exception:
                            pass
                reply = "".join(full_text).strip()
                if reply:
                    return {"success": True, "model": m, "reply": reply}
        except urllib.error.HTTPError as e:
            err_body = e.read().decode("utf-8", errors="ignore")
            last_err = f"HTTP {e.code}: {err_body[:80]}"
        except Exception as e:
            last_err = str(e)

    return {"success": False, "error": last_err or "所有候选模型均无有效响应"}

def run_chat(target_name=None, prompt="请回复：你好", model=None, send_all=False):
    """
    在 CLI 执行与 WorkBuddy 模型的直接对话。
    支持单账号或全账号批量触发每日连续对话。
    """
    sync_active_token_to_profiles()
    profiles = get_profiles()

    targets = {}
    if send_all:
        targets = profiles
    elif target_name and target_name in profiles:
        targets[target_name] = profiles[target_name]
    elif target_name and any(p["nickname"].lower() == target_name.lower() for p in profiles.values()):
        for name, p in profiles.items():
            if p["nickname"].lower() == target_name.lower():
                targets[name] = p
                break
    else:
        if target_name:
            prompt = target_name
        active_data = get_active_account()
        if active_data:
            uid = active_data.get("account", {}).get("uid", "") if isinstance(active_data, dict) and isinstance(active_data.get("account"), dict) else ""
            nick = get_display_nickname(active_data.get("account", {}) if isinstance(active_data, dict) else {}, default_name="active")
            targets["active"] = {
                "data": active_data,
                "uid": uid,
                "nickname": nick
            }
        elif profiles:
            first_key = list(profiles.keys())[0]
            targets[first_key] = profiles[first_key]

    if not targets:
        print(f"{COLOR_RED}错误: 未检测到任何已登录或已保存的账号凭证。{COLOR_RESET}")
        return

    print(f"\n{COLOR_BOLD}{COLOR_CYAN}=== WorkBuddy CLI 对话 ({len(targets)} 个账号) ==={COLOR_RESET}")
    print(f"提示词: {COLOR_BOLD}{prompt}{COLOR_RESET}")

    for name, p in targets.items():
        data = p["data"]
        raw_token = data.get("auth", {}).get("accessToken") if isinstance(data, dict) and isinstance(data.get("auth"), dict) else None
        uid = p["uid"]
        nickname = p["nickname"]

        if not raw_token or not uid:
            print(f" {COLOR_YELLOW}• {name:<12}{COLOR_RESET} [昵称: {nickname}] 缺少有效 Token 或 UID，跳过")
            continue

        try:
            token = resolve_credential_field(raw_token, field_name="accessToken")
        except CredentialError as ce:
            print(f" {COLOR_RED}✖ {name:<12}{COLOR_RESET} [昵称: {nickname}] 凭据解析失败: {ce.message}")
            continue
        except Exception as e:
            print(f" {COLOR_RED}✖ {name:<12}{COLOR_RESET} [昵称: {nickname}] 凭据解析异常: {e}")
            continue

        if not isinstance(token, str) or not is_valid_token_string(token):
            print(f" {COLOR_RED}✖ {name:<12}{COLOR_RESET} [昵称: {nickname}] 凭据无法解析为有效令牌，跳过")
            continue

        res = send_chat_message(token, str(uid), prompt=prompt, model=model)
        if res.get("success"):
            rep = res["reply"]
            print(f" {COLOR_GREEN}✔ {name:<12}{COLOR_RESET} [昵称: {nickname}] 模型: {res['model']} -> {COLOR_BOLD}{rep}{COLOR_RESET}")
        else:
            print(f" {COLOR_RED}✖ {name:<12}{COLOR_RESET} [昵称: {nickname}] 对话失败: {res.get('error')}")

    print(f"{COLOR_CYAN}----------------------------------------------{COLOR_RESET}\n")

def parse_and_run_chat(args):
    """
    智能解析 chat 命令参数：
    支持 -p / --prompt, -m / --model, --all 以及位置参数 [target_name] [prompt]
    """
    send_all = False
    model = None
    prompt = None
    target_name = None

    i = 0
    rem_args = []
    while i < len(args):
        a = args[i]
        if a == "--all":
            send_all = True
            i += 1
        elif a in ["-p", "--prompt"]:
            if i + 1 < len(args):
                prompt = args[i + 1]
                i += 2
            else:
                i += 1
        elif a in ["-m", "--model"]:
            if i + 1 < len(args):
                model = args[i + 1]
                i += 2
            else:
                i += 1
        else:
            rem_args.append(a)
            i += 1

    profiles = get_profiles()
    if rem_args:
        first = rem_args[0]
        if first in profiles or any(p["nickname"].lower() == first.lower() for p in profiles.values()):
            target_name = first
            rem_args = rem_args[1:]

        if rem_args and prompt is None:
            prompt = " ".join(rem_args)

    if not prompt:
        prompt = "请回复：你好"

    run_chat(target_name=target_name, prompt=prompt, model=model, send_all=send_all)

def notify_desktop(title, message):
    if sys.platform == "darwin":
        try:
            safe_title = str(title).replace('"', '\\"')
            safe_msg = str(message).replace('"', '\\"')
            script = f'display notification "{safe_msg}" with title "{safe_title}"'
            subprocess.run(["osascript", "-e", script], check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except Exception:
            pass

def run_checkin(target_name=None, with_chat=True):
    sync_active_token_to_profiles()
    active_data = get_active_account()
    profiles = get_profiles()

    # 自动发现：如果当前客户端登录了一个尚未保存到 profiles 的新账号，自动识别并保存入库
    if active_data:
        active_uid = active_data.get("account", {}).get("uid") if isinstance(active_data, dict) and isinstance(active_data.get("account"), dict) else None
        if active_uid and not any(p["uid"] == active_uid for p in profiles.values()):
            nickname = get_display_nickname(active_data.get("account", {}) if isinstance(active_data, dict) else {}, default_name=str(active_uid)[:8])
            clean_name = re.sub(r"[^\w\-]", "_", str(nickname)).strip("_") or str(active_uid)[:8]
            cand = clean_name
            idx = 1
            while os.path.exists(os.path.join(PROFILES_DIR, f"{cand}.info")):
                cand = f"{clean_name}_{idx}"
                idx += 1
            auto_path = os.path.join(PROFILES_DIR, f"{cand}.info")
            try:
                with open(auto_path, "w", encoding="utf-8") as f:
                    json.dump(active_data, f, indent=2, ensure_ascii=False)
                if sys.platform != "win32":
                    os.chmod(auto_path, 0o600)
                print(f"{COLOR_GREEN}✔ 检测到新登录账号，已自动保存 Profile: '{cand}' (昵称: {nickname}){COLOR_RESET}")
                profiles = get_profiles()
            except Exception:
                pass

    if not profiles:
        print(f"{COLOR_RED}未在 ~/.workbuddy/auth_profiles 中发现任何保存的账号凭证。{COLOR_RESET}")
        return

    targets = {}
    if target_name:
        for name, p in profiles.items():
            if name.lower() == target_name.lower() or p["nickname"].lower() == target_name.lower():
                targets[name] = p
                break
        if not targets:
            print(f"{COLOR_RED}未找到账号: {target_name}{COLOR_RESET}")
            return
    else:
        targets = profiles

    print(f"\n{COLOR_BOLD}{COLOR_CYAN}=== WorkBuddy 自动每日签到与连续对话 ({len(targets)} 个账号) ==={COLOR_RESET}")

    checked_already = 0
    new_checked = 0
    failed = 0

    for name, p in targets.items():
        data = p["data"]
        raw_token = data.get("auth", {}).get("accessToken") if isinstance(data, dict) and isinstance(data.get("auth"), dict) else None
        uid = p["uid"]
        nickname = p["nickname"]

        if not raw_token or not uid:
            print(f" {COLOR_YELLOW}• {name:<12}{COLOR_RESET} [昵称: {nickname}] 缺少有效 Token 或 UID，跳过")
            failed += 1
            continue

        try:
            token = resolve_credential_field(raw_token, field_name="accessToken")
        except CredentialError as ce:
            print(f" {COLOR_RED}✖ {name:<12}{COLOR_RESET} [昵称: {nickname}] 凭据解析失败: {ce.message}")
            failed += 1
            continue
        except Exception as e:
            print(f" {COLOR_RED}✖ {name:<12}{COLOR_RESET} [昵称: {nickname}] 凭据解析异常: {e}")
            failed += 1
            continue

        if not isinstance(token, str) or not is_valid_token_string(token):
            print(f" {COLOR_RED}✖ {name:<12}{COLOR_RESET} [昵称: {nickname}] 凭据无法解析为有效令牌，跳过")
            failed += 1
            continue

        base_headers = {
            "Content-Type": "application/json",
            "Accept": "application/json",
            "Authorization": f"Bearer {token}",
            "X-User-Id": str(uid),
            "User-Agent": "WorkBuddy/5.5.3"
        }

        # 1. 幂等探测签到状态
        status_req = urllib.request.Request(
            "https://copilot.tencent.com/v2/billing/meter/checkin-activity-status",
            data=b"{}",
            headers=base_headers
        )

        try:
            with urllib.request.urlopen(status_req, timeout=10) as resp:
                status_res = json.loads(resp.read().decode("utf-8"))
        except Exception as e:
            print(f" {COLOR_RED}✖ {name:<12}{COLOR_RESET} [昵称: {nickname}] 查询签到状态失败: {e}")
            failed += 1
            continue

        if status_res.get("code") != 0:
            print(f" {COLOR_RED}✖ {name:<12}{COLOR_RESET} [昵称: {nickname}] 接口错误: {status_res.get('msg')}")
            failed += 1
            continue

        status_data = status_res.get("data", {})
        today_checked_in = status_data.get("today_checked_in", False)
        streak_days = status_data.get("streak_days", 0)
        total_credits = status_data.get("total_credits", 0)

        if today_checked_in:
            checked_already += 1
            print(f" {COLOR_GREEN}✔ {name:<12}{COLOR_RESET} [昵称: {nickname}] {COLOR_GREEN}今日已签到{COLOR_RESET} | 连续 {streak_days} 天 | 累计签到奖励 {total_credits} 积分")
        else:
            # 2. 执行签到领取
            claim_req = urllib.request.Request(
                "https://copilot.tencent.com/v2/billing/meter/daily-checkin",
                data=b"{}",
                headers=base_headers
            )

            try:
                with urllib.request.urlopen(claim_req, timeout=10) as resp:
                    claim_res = json.loads(resp.read().decode("utf-8"))
                    if claim_res.get("code") == 0:
                        new_checked += 1
                        cd = claim_res.get("data", {})
                        credit = cd.get("credit", 100)
                        new_streak = cd.get("streak_days", streak_days + 1)
                        print(f" {COLOR_GREEN}🎉 {name:<12}{COLOR_RESET} [昵称: {nickname}] {COLOR_BOLD}{COLOR_GREEN}签到成功！+{credit} 积分{COLOR_RESET} | 连续签到 {new_streak} 天")
                    else:
                        failed += 1
                        print(f" {COLOR_YELLOW}▲ {name:<12}{COLOR_RESET} [昵称: {nickname}] 签到返回: {claim_res.get('msg')}")
            except urllib.error.HTTPError as e:
                err_body = e.read().decode("utf-8", errors="ignore")
                try:
                    err_json = json.loads(err_body)
                    msg = err_json.get("msg", err_body)
                except Exception:
                    msg = err_body
                if "已签到" in msg:
                    checked_already += 1
                    print(f" {COLOR_GREEN}✔ {name:<12}{COLOR_RESET} [昵称: {nickname}] {COLOR_GREEN}{msg}{COLOR_RESET}")
                else:
                    failed += 1
                    print(f" {COLOR_RED}✖ {name:<12}{COLOR_RESET} [昵称: {nickname}] 签到失败 ({e.code}): {msg}")
            except Exception as e:
                failed += 1
                print(f" {COLOR_RED}✖ {name:<12}{COLOR_RESET} [昵称: {nickname}] 请求异常: {e}")

        # 3. 自动触发每日连续对话任务 (获取每日连续对话奖励)
        if with_chat:
            chat_res = send_chat_message(token, str(uid), prompt="请回复：你好")
            if chat_res.get("success"):
                rep = chat_res["reply"].replace("\n", " ").strip()
                if len(rep) > 30:
                    rep = rep[:27] + "..."
                print(f"    💬 {COLOR_CYAN}[每日对话]{COLOR_RESET} 模型: {chat_res['model']} (低倍率/免费) -> 回复: \"{rep}\" ✔")
            else:
                print(f"    💬 {COLOR_YELLOW}[每日对话]{COLOR_RESET} 触发未成功: {chat_res.get('error')}")

    print(f"{COLOR_CYAN}----------------------------------------------{COLOR_RESET}\n")

    if sys.platform == "darwin" and targets:
        summary_parts = []
        if new_checked:
            summary_parts.append(f"{new_checked}个新签到成功")
        if checked_already:
            summary_parts.append(f"{checked_already}个今日已签")
        if failed:
            summary_parts.append(f"{failed}个失败")
        summary_text = "，".join(summary_parts) if summary_parts else "签到完成"
        notify_desktop("WorkBuddy 每日签到", f"共 {len(targets)} 个账号：{summary_text}")

def interactive_menu():
    profiles = get_profiles()
    if not profiles:
        print(f"{COLOR_RED}未在 ~/.workbuddy/auth_profiles 中发现任何保存的账号凭证。{COLOR_RESET}")
        print(f"请登录一个账号后，在终端执行: workbuddy save <别名>")
        return

    active_data = get_active_account()
    active_uid = active_data.get("account", {}).get("uid") if active_data else None

    print(f"\n{COLOR_BOLD}{COLOR_CYAN}=============================================={COLOR_RESET}")
    print(f"{COLOR_BOLD}{COLOR_CYAN}       WorkBuddy 账号切换器 (CC Switch 风格)    {COLOR_RESET}")
    print(f"{COLOR_BOLD}{COLOR_CYAN}=============================================={COLOR_RESET}")
    
    match_active = None
    for name, p in profiles.items():
        if p["uid"] == active_uid:
            match_active = f"{name} ({p['nickname']})"
            break
    print(f"当前在线账号: {COLOR_BOLD}{COLOR_GREEN}{match_active or '未知 / 未登录'}{COLOR_RESET}")
    print(f"\n请选择要切换的目标账号 (一次保存，永久免扫码):")

    keys = list(profiles.keys())
    for idx, name in enumerate(keys, 1):
        p = profiles[name]
        is_cur = (p["uid"] == active_uid)
        prefix = f"{COLOR_GREEN}▶{COLOR_RESET}" if is_cur else " "
        cur_text = f" {COLOR_GREEN}(当前使用中){COLOR_RESET}" if is_cur else ""
        print(f" {prefix} {COLOR_BOLD}{idx}){COLOR_RESET} {name:<12} [昵称: {p['nickname']}]{cur_text}")

    print(f"\n   {COLOR_BOLD}q){COLOR_RESET} 退出 (Cancel)")
    print(f"{COLOR_CYAN}----------------------------------------------{COLOR_RESET}")

    try:
        choice = input(f"{COLOR_BOLD}请输入序号 [1-{len(keys)}] 进行切换: {COLOR_RESET}").strip()
        if not choice or choice.lower() == "q":
            print("已取消。")
            return
        idx = int(choice)
        if 1 <= idx <= len(keys):
            target_name = keys[idx - 1]
            switch_to_profile(target_name, auto_restart=True)
        else:
            print(f"{COLOR_RED}无效的序号: {choice}{COLOR_RESET}")
    except ValueError:
        print(f"{COLOR_RED}请输入正确的数字序号。{COLOR_RESET}")
    except (KeyboardInterrupt, EOFError):
        print("\n已取消。")

def save_current(name):
    active_data = get_active_account()
    if not active_data:
        print(f"{COLOR_RED}错误: 当前没有检测到已登录的 WorkBuddy 凭证。{COLOR_RESET}")
        return
    acc = active_data.get("account", {}) if isinstance(active_data, dict) else {}
    nickname = get_display_nickname(acc, default_name=name)
    uid = acc.get("uid", "") if isinstance(acc, dict) else ""
    os.makedirs(PROFILES_DIR, exist_ok=True)
    target_path = os.path.join(PROFILES_DIR, f"{name}.info")
    with open(target_path, "w", encoding="utf-8") as f:
        json.dump(active_data, f, indent=2, ensure_ascii=False)
    if sys.platform != "win32":
        os.chmod(target_path, 0o600)
    print(f"{COLOR_GREEN}✔ 当前登录态已成功保存为 Profile: '{name}' (昵称: {nickname}, UID: {uid}){COLOR_RESET}")
    print(f"{COLOR_GREEN}  凭证已按原生格式保存（保持加密格式，解密仅在内存中执行）。{COLOR_RESET}")

def run_doctor():
    """
    诊断 WorkBuddy Toolkit 与当前环境及凭据格式的兼容性。
    不打印任何明文 Token、密钥或完整信封。
    """
    print(f"\n{COLOR_BOLD}{COLOR_CYAN}=== WorkBuddy Toolkit Doctor ==={COLOR_RESET}\n")

    auth_exists = os.path.exists(AUTH_FILE)
    auth_status = f"{COLOR_GREEN}OK{COLOR_RESET}" if auth_exists else f"{COLOR_YELLOW}MISSING{COLOR_RESET}"
    print(f"Auth file             : {auth_status} ({AUTH_FILE})")

    active_data = get_active_account()
    raw_token = active_data.get("auth", {}).get("accessToken") if isinstance(active_data, dict) and isinstance(active_data.get("auth"), dict) else None

    token_fmt = check_token_format(raw_token)
    if not auth_exists or not active_data or raw_token is None:
        fmt_display = "none"
        scheme_display = "none"
    elif token_fmt == "plaintext":
        fmt_display = "plaintext"
        scheme_display = "none"
    elif token_fmt == "sym-v1":
        fmt_display = "encrypted"
        scheme_display = "detected (sym-v1 / suite 1)"
    elif token_fmt == "unsupported":
        fmt_display = "encrypted (unsupported suite)"
        scheme_display = "unknown"
    else:
        fmt_display = "unknown"
        scheme_display = "unknown"

    print(f"Credential format     : {fmt_display}")
    print(f"Encrypted scheme      : {scheme_display}")

    runtime_path = None
    runtime_found = False
    try:
        runtime_path = find_workbuddy_runtime()
        runtime_found = True
        rt_status = f"{COLOR_GREEN}FOUND{COLOR_RESET} ({runtime_path})"
    except CredentialError as e:
        rt_status = f"{COLOR_RED}MISSING{COLOR_RESET} ({e.message})"
    except Exception as e:
        rt_status = f"{COLOR_RED}MISSING{COLOR_RESET} ({e})"

    print(f"WorkBuddy runtime     : {rt_status}")

    resolver_avail = False
    if runtime_found:
        try:
            probe = run_native_resolver(runtime_path, {"operation": "probe"})
            if probe.get("ok"):
                resolver_avail = True
                electron_ver = probe.get("electron", "unknown")
                res_status = f"{COLOR_GREEN}AVAILABLE{COLOR_RESET} (Electron {electron_ver})"
            else:
                res_status = f"{COLOR_RED}UNAVAILABLE{COLOR_RESET} ({probe.get('reason')})"
        except CredentialError as e:
            res_status = f"{COLOR_RED}UNAVAILABLE{COLOR_RESET} ({e.message})"
        except Exception as e:
            res_status = f"{COLOR_RED}UNAVAILABLE{COLOR_RESET} ({e})"
    else:
        res_status = f"{COLOR_YELLOW}UNAVAILABLE{COLOR_RESET}"

    print(f"Credential resolver   : {res_status}")

    profiles = get_profiles()
    print(f"Profile count         : {len(profiles)}")

    # 判断 API capability
    api_ready = False
    if token_fmt == "plaintext":
        api_ready = True
    elif token_fmt == "sym-v1" and resolver_avail:
        api_ready = True
    elif not auth_exists and profiles:
        all_ok = True
        for p in profiles.values():
            p_tok = p["data"].get("auth", {}).get("accessToken") if isinstance(p.get("data"), dict) and isinstance(p["data"].get("auth"), dict) else None
            p_fmt = check_token_format(p_tok)
            if p_fmt == "sym-v1" and not resolver_avail:
                all_ok = False
            elif p_fmt in ("unsupported", "malformed"):
                all_ok = False
        api_ready = all_ok and len(profiles) > 0

    api_status = f"{COLOR_GREEN}READY{COLOR_RESET}" if api_ready else f"{COLOR_RED}BLOCKED{COLOR_RESET}"
    print(f"API capability        : {api_status}")

    # RESULT: COMPATIBLE 或 INCOMPATIBLE
    is_compatible = api_ready or (not auth_exists and not profiles)
    result_text = f"{COLOR_BOLD}{COLOR_GREEN}COMPATIBLE{COLOR_RESET}" if is_compatible else f"{COLOR_BOLD}{COLOR_RED}INCOMPATIBLE{COLOR_RESET}"
    print(f"\nRESULT: {result_text}\n")
    return is_compatible

def print_help():
    print(f"""
{COLOR_BOLD}WorkBuddy 账号切换与自动化管理工具 (workbuddy CLI v{VERSION}){COLOR_RESET}

核心特性:
  ★ 免重新扫码账号切换：保存已验证凭证 Profile，切号即时生效。
  ★ 原生加密兼容支持：完整兼容 WorkBuddy 5.6+ 敏感字段加密格式 ($wbEncrypted)。
  ★ 每日打卡与每日连续对话任务联动：一次打卡自动获得积分与连续对话活跃奖励！
  ★ 状态深度自检：自带 doctor 命令，快速诊断本地解密运行时与 API 就绪能力。

用法:
  workbuddy switch [账号名]       切换到指定账号（省略参数则进入交互式菜单）
  workbuddy checkin [账号名]      自动执行每日签到与每日连续对话（默认遍历所有已存账号）
  workbuddy chat [提示词]         向当前活跃账号发送对话（智能优先免费/最低倍率模型）
  workbuddy chat --all [提示词]   对所有已保存账号批量发送对话，维持连续对话奖励
  workbuddy doctor              检查当前凭据格式、本地解密运行时及兼容状态
  workbuddy status              查看当前登录账号状态及凭据格式
  workbuddy list                列出本地已保存的所有账号凭证
  workbuddy save <账号别名>       将当前活跃的登录态保存为一个新账号 Profile
  workbuddy init                一键对本地数据库打补丁，实现全账号工作区共享
  workbuddy rollback            移除共享触发器，恢复官方默认数据隔离
  workbuddy restart             重启 WorkBuddy 客户端

快捷别名:
  wb-switch [账号名]
  wb-checkin [账号名]
  wb-chat [提示词]
  wb-doctor
  workbuddy-switch [账号名]
  workbuddy-checkin [账号名]
  workbuddy-chat [提示词]
  workbuddy-doctor
""")

def main():
    prog_name = os.path.basename(sys.argv[0]).lower()
    args = sys.argv[1:]

    # 如果通过快捷别名调用
    if "doctor" in prog_name:
        ok = run_doctor()
        sys.exit(0 if ok else 1)
    if "chat" in prog_name:
        parse_and_run_chat(args)
        return
    if "checkin" in prog_name:
        with_chat = ("--no-chat" not in args)
        clean_args = [a for a in args if a != "--no-chat"]
        target = clean_args[0] if clean_args else None
        run_checkin(target, with_chat=with_chat)
        return
    if "switch" in prog_name:
        if args:
            switch_to_profile(args[0], auto_restart=True)
        else:
            interactive_menu()
        return

    if not args:
        interactive_menu()
        return

    cmd = args[0].lower()
    if cmd in ["doctor", "check", "diag", "diagnose"]:
        ok = run_doctor()
        sys.exit(0 if ok else 1)
    elif cmd in ["switch", "use"]:
        if len(args) > 1:
            switch_to_profile(args[1], auto_restart=True)
        else:
            interactive_menu()
    elif cmd in ["checkin", "check-in", "sign", "signin"]:
        with_chat = ("--no-chat" not in args)
        clean_args = [a for a in args[1:] if a != "--no-chat"]
        target = clean_args[0] if clean_args else None
        run_checkin(target, with_chat=with_chat)
    elif cmd in ["chat", "ask", "tell"]:
        parse_and_run_chat(args[1:])
    elif cmd in ["status", "info", "whoami"]:
        show_status()
    elif cmd in ["list", "ls"]:
        show_status()
    elif cmd in ["save", "backup"]:
        if len(args) > 1:
            save_current(args[1])
        else:
            print(f"{COLOR_RED}请提供保存的名称，例如: workbuddy save myaccount{COLOR_RESET}")
    elif cmd in ["init", "patch"]:
        init_shared_workspace()
    elif cmd in ["rollback", "unpatch"]:
        restore_uid = args[1] if len(args) > 1 else None
        rollback_shared_workspace(restore_uid)
    elif cmd in ["restart"]:
        restart_workbuddy()
    elif cmd in ["-v", "--version", "version"]:
        print(f"workbuddy toolkit v{VERSION}")
    elif cmd in ["-h", "--help", "help"]:
        print_help()
    else:
        profiles = get_profiles()
        if cmd in profiles or any(p["nickname"].lower() == cmd for p in profiles.values()):
            switch_to_profile(cmd, auto_restart=True)
        else:
            print(f"{COLOR_RED}未知命令或账号: {cmd}{COLOR_RESET}")
            print_help()

if __name__ == "__main__":
    main()
