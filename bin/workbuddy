def robust_urlopen(req, timeout=10, max_retries=2):
    """
    鲁棒网络请求封装：
    针对腾讯国内接口 (copilot.tencent.com)，若外部环境设置了代理环境变量 (如 127.0.0.1:7897)，
    在遭遇代理握手中断 (如 _ssl.c EOF violation)、连接重置或网络抖动时，
    自动回退至直连模式 (Bypass Proxy) 并按指数退避重试，确保在 Antigravity Sidecar、海外代理或宿主环境波动下 100% 成功交付。
    """
    has_proxy = any(os.environ.get(k) for k in ("HTTP_PROXY", "HTTPS_PROXY", "ALL_PROXY", "http_proxy", "https_proxy", "all_proxy"))
    direct_opener = None

    last_err = None
    for attempt in range(max_retries + 1):
        try:
            if attempt > 0 and has_proxy:
                if direct_opener is None:
                    direct_opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
                return direct_opener.open(req, timeout=timeout)
            return urllib.request.urlopen(req, timeout=timeout)
        except urllib.error.HTTPError:
            # 服务端响应的 HTTP 状态码 (4xx, 5xx) 属于应用层交互，直接向上抛出供业务解析
            raise
        except Exception as e:
            last_err = e
            if attempt < max_retries:
                time.sleep(0.3 * (attempt + 1))
            else:
                if has_proxy and direct_opener is None:
                    try:
                        direct_opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
                        return direct_opener.open(req, timeout=timeout)
                    except Exception as direct_e:
                        raise direct_e from last_err
                raise

# ==============================================================================
# Credential Compatibility Layer (支持旧版明文凭据与 WorkBuddy 5.6+ 加密凭据)
# 核心原则：DO NOT DECRYPT FOR STORAGE（持久化保留原始格式，仅在请求时临时内存解密）
# 实际实现与安全边界保证：
# - plaintext credential 不主动持久化
# - 不写 auth profile
# - 不写临时文件
# - 不写日志
# - 不主动打印
# - 仅在当前进程/子进程内瞬态使用
# 注意：JS Buffer 的 key/plaintext fill(0) 虽尽力擦除底层缓冲区，但 JS string、
# JSON 序列化传输以及 Python bytes/string 受语言不可变对象限制，无法保证立即物理 zeroization。
# ==============================================================================

AUTH_INPUT_LIMIT = 65536
AUTH_OUTPUT_LIMIT = 65536
TOKEN_LIMIT = 32768
NICKNAME_LIMIT = 256
AUTH_HELPER_TIMEOUT = 10.0

AUTH_REASONS = {
    "INVALID_FORMAT": "凭据格式无效或信封数据损坏",
    "UNSUPPORTED_ENVELOPE": "不支持的加密凭据格式（仅支持 suite 1 / sym-v1）",
    "RUNTIME_NOT_FOUND": "未检测到可用的 WorkBuddy 客户端运行时，请配置 WORKBUDDY_EXE 环境变量",
    "INVALID_RUNTIME_PATH": "WORKBUDDY_EXE 指定的文件不存在或不可执行",
    "RUNTIME_UNAVAILABLE": "客户端运行时不支持所需的原生存储解密接口",
    "KEY_MISMATCH": "凭据与当前 WorkBuddy 运行时的密钥不匹配",
    "DECRYPT_FAILED": "加密凭据认证或解密失败",
    "HELPER_TIMEOUT": "凭据解密助手子进程执行超时",
    "HELPER_PROTOCOL": "客户端解密通信协议异常",
    "AUTH_CREDENTIAL_UNRESOLVED": "凭据解析失败，无法获取有效认证令牌",
}

# 最小 Node.js 解密助手（通过 stdin/stdout 安全通信，瞬态内存解密，绝不落盘，绝不打印）
AUTH_HELPER_JS = r"""
'use strict';
const crypto = require('crypto');
const inputLimit = 65536;
const failure = reason => { throw {reason}; };
const object = x => x !== null && typeof x === 'object' && !Array.isArray(x);
function base64(value, length) {
  if (typeof value !== 'string' || value.length > inputLimit) failure('INVALID_FORMAT');
  const bytes = Buffer.from(value, 'base64');
  if (bytes.toString('base64') !== value || (length !== undefined && bytes.length !== length))
    failure('INVALID_FORMAT');
  return bytes;
}
function utf8(bytes) {
  const text = bytes.toString('utf8');
  if (!Buffer.from(text, 'utf8').equals(bytes)) failure('INVALID_FORMAT');
  return text;
}
function decode(value) {
  if (!object(value) || Object.keys(value).sort().join(',') !== '$wbEncrypted,envelope' || value.$wbEncrypted !== 1)
    failure('UNSUPPORTED_ENVELOPE');
  let envelope;
  try { envelope = JSON.parse(utf8(base64(value.envelope))); }
  catch (e) { failure(e.reason || 'INVALID_FORMAT'); }
  if (!object(envelope) || !Number.isInteger(envelope.suite)) failure('INVALID_FORMAT');
  if (envelope.suite !== 1) failure('UNSUPPORTED_ENVELOPE');
  if (Object.keys(envelope).sort().join(',') !== 'authTag,ciphertext,keyId,nonce,suite' ||
      typeof envelope.keyId !== 'string' || !/^[0-9a-f]{16}$/.test(envelope.keyId)) failure('INVALID_FORMAT');
  return {keyId: envelope.keyId, nonce: base64(envelope.nonce, 12),
    tag: base64(envelope.authTag, 16), ciphertext: base64(envelope.ciphertext)};
}
function nativeStorage() {
  try {
    const storage = process._linkedBinding('electron_browser_workbuddy_storage');
    if (typeof storage.loggerGet !== 'function') failure('RUNTIME_UNAVAILABLE');
    return storage;
  } catch (_) { failure('RUNTIME_UNAVAILABLE'); }
}
function getAtRestKey() {
  let payload;
  try { payload = JSON.parse(nativeStorage().loggerGet()); }
  catch (_) { failure('RUNTIME_UNAVAILABLE'); }
  if (!object(payload) || payload.version !== 1) failure('RUNTIME_UNAVAILABLE');
  let secret;
  try { secret = base64(payload.atRestSecretKey, 32); }
  catch (_) { failure('RUNTIME_UNAVAILABLE'); }
  const empty = secret.every(b => b === 0);
  secret.fill(0);
  if (empty) failure('RUNTIME_UNAVAILABLE');
  const key = crypto.createHash('sha256').update(payload.atRestSecretKey, 'utf8').digest();
  const keyId = crypto.createHash('sha256').update(key).digest('hex').slice(0, 16);
  return { key, keyId };
}
function decrypt(envelope) {
  let keyState;
  let plaintext;
  try {
    keyState = getAtRestKey();
    if (keyState.keyId !== envelope.keyId) failure('KEY_MISMATCH');
    const lp = s => {
      const bytes = Buffer.from(s, 'utf8');
      const length = Buffer.alloc(4); length.writeUInt32BE(bytes.length);
      return Buffer.concat([length, bytes]);
    };
    const aad = Buffer.concat([Buffer.from('WB-AAD\0', 'ascii'), Buffer.from([1]),
      lp('WBEV1'), lp('sym-v1'), Buffer.from([0, 0, 0, 1]), lp(envelope.keyId), Buffer.from([2, 0, 0])]);
    try {
      const cipher = crypto.createDecipheriv('aes-256-gcm', keyState.key, envelope.nonce, {authTagLength: 16});
      cipher.setAAD(aad); cipher.setAuthTag(envelope.tag);
      plaintext = Buffer.concat([cipher.update(envelope.ciphertext), cipher.final()]);
    } catch (_) { failure('DECRYPT_FAILED'); }
    const text = utf8(plaintext);
    if (!text.length || text.length > 32768)
      failure('INVALID_FORMAT');
    return text;
  } finally {
    if (keyState && keyState.key) keyState.key.fill(0);
    if (plaintext) plaintext.fill(0);
  }
}
function encrypt(plaintext) {
  let keyState;
  try {
    keyState = getAtRestKey();
    const nonce = crypto.randomBytes(12);
    const lp = s => {
      const bytes = Buffer.from(s, 'utf8');
      const length = Buffer.alloc(4); length.writeUInt32BE(bytes.length);
      return Buffer.concat([length, bytes]);
    };
    const aad = Buffer.concat([Buffer.from('WB-AAD\0', 'ascii'), Buffer.from([1]),
      lp('WBEV1'), lp('sym-v1'), Buffer.from([0, 0, 0, 1]), lp(keyState.keyId), Buffer.from([2, 0, 0])]);
    const cipher = crypto.createCipheriv('aes-256-gcm', keyState.key, nonce, {authTagLength: 16});
    cipher.setAAD(aad);
    const ciphertext = Buffer.concat([cipher.update(Buffer.from(plaintext, 'utf8')), cipher.final()]);
    const authTag = cipher.getAuthTag();
    const envelope = {
      suite: 1,
      keyId: keyState.keyId,
      nonce: nonce.toString('base64'),
      authTag: authTag.toString('base64'),
      ciphertext: ciphertext.toString('base64')
    };
    return {
      $wbEncrypted: 1,
      envelope: Buffer.from(JSON.stringify(envelope), 'utf8').toString('base64')
    };
  } finally {
    if (keyState && keyState.key) keyState.key.fill(0);
  }
}
let chunks = [], size = 0;
function reply(value) {
  process.stdout.write(JSON.stringify({version: 1, ...value}), () => process.exit(value.ok ? 0 : 1));
}
process.stdin.on('data', chunk => {
  size += chunk.length;
  if (size > inputLimit) reply({ok: false, reason: 'INVALID_FORMAT'});
  else chunks.push(chunk);
});
process.stdin.on('error', () => reply({ok: false, reason: 'HELPER_PROTOCOL'}));
process.stdin.on('end', () => {
  try {
    const request = JSON.parse(utf8(Buffer.concat(chunks))); chunks = [];
    if (!object(request) || request.version !== 1) failure('HELPER_PROTOCOL');
    if (request.operation === 'probe') {
      nativeStorage();
      if (!crypto.getCiphers().includes('aes-256-gcm')) failure('RUNTIME_UNAVAILABLE');
      reply({ok: true, electron: process.versions.electron || 'unknown'});
    } else if (request.operation === 'decrypt') {
      const decrypted = decrypt(decode(request.value));
      reply({ok: true, value: decrypted, accessToken: decrypted});
    } else if (request.operation === 'encrypt') {
      if (typeof request.value !== 'string' || !request.value.length || request.value.length > 32768)
        failure('INVALID_FORMAT');
      const encrypted = encrypt(request.value);
      reply({ok: true, value: encrypted});
    } else failure('HELPER_PROTOCOL');
  } catch (e) {
    const reasons = ['INVALID_FORMAT','UNSUPPORTED_ENVELOPE','RUNTIME_UNAVAILABLE',
      'KEY_MISMATCH','DECRYPT_FAILED','HELPER_PROTOCOL'];
    reply({ok: false, reason: reasons.includes(e.reason) ? e.reason : 'HELPER_PROTOCOL'});
  }
});
"""

class CredentialError(Exception):
    def __init__(self, reason, message=None):
        self.reason = reason
        self.message = message or AUTH_REASONS.get(reason, f"认证错误: {reason}")
        super().__init__(self.message)

def is_valid_token_string(token):
    return (
        isinstance(token, str)
        and 0 < len(token) <= TOKEN_LIMIT
        and re.fullmatch(r"[A-Za-z0-9._~+\/-]+=*", token) is not None
    )

def is_valid_nickname_string(nick):
    """
    根据 field_name="nickname" 进行最小字段级验证：
    - 必须为合法非空字符串，长度在 1 到 256 字符之间，且不全为空白
    - 允许合法 UTF-8 Unicode 文本（包含中文、日文、Emoji 等）以及包含正常空格的昵称
    - 拒绝 NUL (\x00) 及不可见控制字符 (ord < 32 或 Unicode 类别 Cc / Cs)
    - 不得应用 accessToken 专用字符集 regex
    """
    if not isinstance(nick, str):
        return False
    if not (0 < len(nick) <= NICKNAME_LIMIT) or not nick.strip():
        return False
    for ch in nick:
        if ord(ch) < 32 or unicodedata.category(ch) in ("Cc", "Cs"):
            return False
    return True

def is_encrypted_credential(value):
    return (
        isinstance(value, dict)
        and value.get("$wbEncrypted") == 1
        and "envelope" in value
    )

def check_token_format(value):
    """
    检查 token 格式:
    - 'plaintext' (有效字符串)
    - 'sym-v1' (有效 suite 1 加密信封)
    - 'unsupported' (不支持的加密格式)
    - 'malformed' (格式损坏)
    - 'missing' (空值)
    """
    if value is None:
        return "missing"
    if isinstance(value, str):
        return "plaintext" if is_valid_token_string(value) else "malformed"
    if isinstance(value, dict):
        if set(value.keys()) != {"$wbEncrypted", "envelope"} or value.get("$wbEncrypted") != 1:
            return "unsupported"
        encoded = value.get("envelope")
        if not isinstance(encoded, str) or not (0 < len(encoded) <= AUTH_INPUT_LIMIT - 1024):
            return "malformed"
        try:
            raw = base64.b64decode(encoded, validate=True)
            if base64.b64encode(raw).decode("ascii") != encoded:
                return "malformed"
            envelope = json.loads(raw.decode("utf-8"))
            if not isinstance(envelope, dict):
                return "malformed"
            suite = envelope.get("suite")
            if suite != 1:
                return "unsupported"
            if set(envelope.keys()) != {"suite", "keyId", "nonce", "authTag", "ciphertext"}:
                return "malformed"
            if not isinstance(envelope.get("keyId"), str) or not re.fullmatch(r"[0-9a-f]{16}", envelope["keyId"]):
                return "malformed"
            for field, length in (("nonce", 12), ("authTag", 16), ("ciphertext", None)):
                data = envelope.get(field)
                if not isinstance(data, str):
                    return "malformed"
                dec = base64.b64decode(data, validate=True)
                if base64.b64encode(dec).decode("ascii") != data or (length is not None and len(dec) != length):
                    return "malformed"
            return "sym-v1"
        except Exception:
            return "malformed"
    return "malformed"

