[Unit]
Description=WorkBuddy Multi-Account Daily Checkin Service
After=network.target network-online.target

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'exec "$HOME/.local/bin/workbuddy" checkin >> "$HOME/.workbuddy/logs/checkin.log" 2>&1'
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
